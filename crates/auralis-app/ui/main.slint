// Acustia Player v0.0.1 Alpha — interfaz neumórfica.
// Neumorfismo: superficies del mismo color que el fondo, con una sombra clara
// arriba-izquierda y otra oscura abajo-derecha. Slint admite una sola sombra
// por elemento, así que se anidan dos rectángulos (ver NeuRaised).
import { Button, CheckBox, LineEdit, ComboBox } from "std-widgets.slint";
import { ListView } from "std-widgets.slint";
export global Theme {
    // false = tema claro (blanco), true = tema oscuro (negro).
    in-out property <bool> dark: false;

    out property <color> bg: dark ? #2a2e38 : #e4e8ef;
    out property <color> light: dark ? #373c49 : #ffffff;
    out property <color> shadow: dark ? #1a1d24 : #b9c1d1;
    out property <color> text: dark ? #e8ebf3 : #3b4256;
    out property <color> text-dim: dark ? #8f98ad : #8c95aa;
    out property <color> accent: dark ? #8d9bff : #6577f5;
    out property <color> inset-top: dark ? #1f222a : #d3d9e4;
    out property <color> inset-bottom: dark ? #30343f : #eef1f6;
    out property <color> inset-border: dark ? #ffffff12 : #ffffff80;
    out property <color> row-current: dark ? #343a48 : #d9deea;
    out property <color> row-hover: dark ? #ffffff0c : #00000008;
}

export struct TrackItem {
    // Posición de la canción en su carpeta (con la búsqueda activa la lista
    // mostrada es un subconjunto, así que no coincide con la fila).
    index: int,
    title: string,
    subtitle: string,
    duration: string,
    cover: image,
    has-cover: bool,
    current: bool,
    // El usuario le cambió el nombre (solo se ve en la app; el archivo no se toca).
    edited: bool,
}

export struct FolderItem {
    name: string,
    count: int,
    // La reproducción en curso viene de esta carpeta.
    playing: bool,
    // La carpeta ya no existe en el disco.
    missing: bool,
}

// Superficie en relieve.
component NeuRaised inherits Rectangle {
    in property <length> radius: 18px;
    in property <length> depth: 6px;
    background: Theme.bg;
    border-radius: root.radius;
    drop-shadow-color: Theme.light;
    drop-shadow-blur: root.depth * 2;
    drop-shadow-offset-x: -root.depth;
    drop-shadow-offset-y: -root.depth;

    Rectangle {
        background: Theme.bg;
        border-radius: root.radius;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: root.depth * 2;
        drop-shadow-offset-x: root.depth;
        drop-shadow-offset-y: root.depth;
        @children
    }
}

// Superficie hundida (aproximación con degradado).
component NeuInset inherits Rectangle {
    in property <length> radius: 18px;
    border-radius: root.radius;
    background: @linear-gradient(135deg, Theme.inset-top 0%, Theme.inset-bottom 100%);
    border-width: 1px;
    border-color: Theme.inset-border;
}

// Botón redondo; al pulsarse o estar activo "se hunde".
component NeuButton inherits Rectangle {
    in property <length> size: 56px;
    in property <bool> active: false;
    callback clicked();
    width: root.size;
    height: root.size;

    NeuRaised {
        radius: root.size / 2;
        depth: (ta.pressed || root.active) ? 2px : 6px;
        @children
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Botón alargado con texto.
component NeuPill inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 44px;
    min-width: 150px;

    NeuRaised {
        radius: 22px;
        depth: ta.pressed ? 2px : 5px;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Interruptor encendido/apagado.
component NeuSwitch inherits Rectangle {
    in property <bool> on;
    callback toggled();
    width: 46px;
    height: 26px;

    NeuInset {
        radius: 13px;
    }
    Rectangle {
        x: root.on ? root.width - self.width - 3px : 3px;
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.on ? Theme.accent : Theme.text-dim;
        animate x { duration: 120ms; }
    }
    TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

// Botón redondo pequeño con un texto (− / +).
component MiniButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: 30px;
    height: 30px;

    NeuRaised {
        radius: 15px;
        depth: ta.pressed ? 1px : 3px;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: 16px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// CD neumórfico: gira mientras `spinning` y muestra la carátula como etiqueta del disco.
component SpinningDisc inherits Rectangle {
    in property <image> cover;
    in property <bool> has-cover;
    in property <bool> spinning;
    property <angle> angle: 0deg;
    width: 270px;
    height: 270px;

    // ~73°/s (una vuelta cada 5 s) a 30 fotogramas por segundo, solo mientras suena.
    Timer {
        interval: 33ms;
        running: root.spinning;
        triggered => {
            root.angle = root.angle + 2.4deg;
            if (root.angle >= 360deg) {
                root.angle = root.angle - 360deg;
            }
        }
    }

    // Relieve neumórfico circular.
    NeuRaised {
        radius: root.width / 2;
        depth: 10px;

        // Disco (recortado en círculo).
        Rectangle {
            x: 14px;
            y: 14px;
            width: parent.width - 28px;
            height: parent.height - 28px;
            border-radius: self.width / 2;
            clip: true;
            background: Theme.inset-top;

            // Sin carátula: disco plateado (asimétrico para que se vea el giro).
if !root.has-cover: Image {
    source: @image-url("../assets/disc-blank.png");
    image-fit: ImageFit.cover;
    width: parent.width;
    height: parent.height;
    transform-rotation: root.angle;
}
            if root.has-cover: Image {
                source: root.cover;
                image-fit: ImageFit.cover;
                width: parent.width;
                height: parent.height;
                transform-rotation: root.angle;
            }

            // Capas fijas (no giran): brillo de la luz y borde del disco.
            Rectangle {
                background: @linear-gradient(135deg, #ffffff40 0%, #ffffff00 38%, #00000000 62%, #00000030 100%);
            }
            Rectangle {
                border-radius: self.width / 2;
                border-width: 2px;
                border-color: #ffffff33;
            }
            // Anillo interior de datos (el borde de la zona grabada).
            Rectangle {
                x: parent.width * 0.30;
                y: parent.height * 0.30;
                width: parent.width * 0.40;
                height: parent.height * 0.40;
                border-radius: self.width / 2;
                border-width: 1px;
                border-color: #ffffff2a;
            }
            // Cubo central con el agujero.
            Rectangle {
                x: (parent.width - 76px) / 2;
                y: (parent.height - 76px) / 2;
                width: 76px;
                height: 76px;
                border-radius: 38px;
                background: @linear-gradient(135deg, Theme.light 0%, Theme.shadow 100%);
                border-width: 2px;
                border-color: #ffffff40;
                Rectangle {
                    x: (parent.width - 26px) / 2;
                    y: (parent.height - 26px) / 2;
                    width: 26px;
                    height: 26px;
                    border-radius: 13px;
                    background: Theme.bg;
                    border-width: 2px;
                    border-color: #00000040;
                }
            }
        }
    }
}

// Campo de texto con etiqueta.
component NeuField inherits Rectangle {
    in property <string> label;
    in-out property <string> value;
    in property <bool> disabled: false;
    callback accepted();
    callback escaped();
    height: 58px;

    VerticalLayout {
        spacing: 3px;
        Text {
            text: root.label;
            color: Theme.text-dim;
            font-size: 11px;
        }
        NeuInset {
            height: 36px;
            radius: 12px;
            TextInput {
                x: 12px;
                y: (parent.height - self.preferred-height) / 2;
                width: parent.width - 24px;
                text <=> root.value;
                read-only: root.disabled;
                color: root.disabled ? Theme.text-dim : Theme.text;
                font-size: 14px;
                single-line: true;
                accepted => {
                    root.accepted();
                }
                key-pressed(e) => {
                    if (e.text == Key.Escape) {
                        root.escaped();
                        return accept;
                    }
                    return reject;
                }
            }
        }
    }
}

// Botón de texto (enlace).
component TextButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 26px;
    Text {
        text: root.label;
        color: ta.has-hover ? Theme.accent : Theme.text-dim;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Deslizador (progreso y volumen). `value` va de 0 a 1.
component NeuSlider inherits Rectangle {
    in-out property <float> value: 0;
    out property <bool> dragging: ta.pressed;
    callback moved(float);
    callback released(float);
    height: 24px;

    function fraction(x: length) -> float {
        return max(0.0, min(1.0, x / root.width));
    }

    NeuInset {
        y: (root.height - 10px) / 2;
        height: 10px;
        radius: 5px;
        Rectangle {
            x: 0px;
            width: parent.width * max(0.0, min(1.0, root.value));
            border-radius: 5px;
            background: Theme.accent;
        }
    }

    NeuRaised {
        width: 22px;
        height: 22px;
        radius: 11px;
        depth: 3px;
        x: (root.width - self.width) * max(0.0, min(1.0, root.value));
        y: (root.height - self.height) / 2;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.accent;
        }
    }

    ta := TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) {
                    root.value = root.fraction(self.mouse-x);
                    root.moved(root.value);
                } else if (e.kind == PointerEventKind.up) {
                    root.released(root.value);
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.value = root.fraction(self.mouse-x);
                root.moved(root.value);
            }
        }
    }
}

component TrackRow inherits Rectangle {
    in property <TrackItem> item;
    callback activated();
    callback edit();
    height: 64px;
    border-radius: 14px;
    background: root.item.current ? Theme.row-current : (ta.has-hover ? Theme.row-hover : transparent);

    // Va antes que el contenido para que el botón de editar quede por encima.
    ta := TouchArea {
        clicked => {
            root.activated();
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 14px;

        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            clip: true;
            background: @linear-gradient(135deg, Theme.inset-top 0%, Theme.inset-bottom 100%);
            if root.item.has-cover: Image {
                source: root.item.cover;
                image-fit: cover;
                width: parent.width;
                height: parent.height;
            }
            if !root.item.has-cover: Text {
                text: "♪";
                color: Theme.text-dim;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.item.title;
                color: root.item.current ? Theme.accent : Theme.text;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.item.subtitle;
                color: Theme.text-dim;
                font-size: 12px;
                overflow: elide;
            }
        }

        Text {
            text: root.item.duration;
            color: Theme.text-dim;
            font-size: 13px;
            vertical-alignment: center;
        }

        // Editar el nombre mostrado.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 15px;
                background: edit-ta.has-hover ? Theme.row-current : transparent;
                Path {
                    x: (parent.width - 14px) / 2;
                    y: (parent.height - 14px) / 2;
                    width: 14px;
                    height: 14px;
                    viewbox-width: 14;
                    viewbox-height: 14;
                    commands: "M 1 13 L 1 10 L 10 1 L 13 4 L 4 13 Z M 8 3 L 11 6";
                    stroke: root.item.edited ? Theme.accent : Theme.text-dim;
                    stroke-width: 1.5px;
                }
                edit-ta := TouchArea {
                    clicked => {
                        root.edit();
                    }
                }
            }
        }
    }
}

// Pestaña de una carpeta.
component FolderChip inherits Rectangle {
    in property <FolderItem> item;
    in property <bool> selected;
    callback activated();
    callback removed();
    width: 168px;
    height: 44px;

    if root.selected: NeuInset {
        radius: 14px;
    }
    if !root.selected: NeuRaised {
        radius: 14px;
        depth: 3px;
    }

    ta := TouchArea {
        clicked => {
            root.activated();
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 6px;
        if root.item.playing: Text {
            text: "♪";
            color: Theme.accent;
            font-size: 14px;
            vertical-alignment: center;
        }
        if root.item.missing: Text {
            text: "⚠";
            color: Theme.text-dim;
            font-size: 14px;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.item.name;
            color: root.selected ? Theme.accent : Theme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: rm-ta.has-hover ? Theme.row-current : transparent;
                Path {
                    x: (parent.width - 10px) / 2;
                    y: (parent.height - 10px) / 2;
                    width: 10px;
                    height: 10px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    commands: "M 1 1 L 9 9 M 9 1 L 1 9";
                    stroke: Theme.text-dim;
                    stroke-width: 1.5px;
                }
                rm-ta := TouchArea {
                    clicked => {
                        root.removed();
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Acustia Player";
    icon: @image-url("../assets/icon-256.png");
    min-width: 880px;
    min-height: 600px;
    preferred-width: 1060px;
    preferred-height: 680px;
    background: Theme.bg;

    // --- Datos (los rellena Rust) ---
    in property <[TrackItem]> tracks;
    in property <string> folder-name: "Ninguna carpeta seleccionada";
    in property <[FolderItem]> folders;
    in property <int> selected-folder: 0;
    // Texto que se muestra cuando la lista está vacía (leyendo, sin resultados…).
    in property <string> empty-text: "Añade una carpeta para ver tu música";
    in-out property <string> search-text;
    // Diálogo para editar los metadatos de una canción.
    in-out property <bool> editing: false;
    in property <string> edit-file;
    in-out property <string> edit-title;
    in-out property <string> edit-artist;
    in-out property <string> edit-album;
    in-out property <string> edit-genre;
    in-out property <string> edit-year;
    in property <image> edit-cover;
    in property <bool> edit-has-cover: false;
    // Leyendo o guardando: los campos no se pueden tocar.
    in property <bool> edit-busy: false;
    in property <string> edit-error;
    in property <string> status-message;
    in property <string> current-title: "Acustia Player";
    in property <string> current-artist: "Abre una carpeta con música";
    in property <image> current-cover;
    in property <bool> has-cover: false;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in-out property <float> progress: 0;
    in-out property <float> volume: 0.8;
    // Normalizar el volumen de cada canción y duración del crossfade (0 = desactivado).
    in-out property <bool> normalize: true;
    in-out property <int> crossfade-secs: 0;
    in property <bool> playing: false;
    in property <bool> shuffle: false;
    in property <int> repeat-mode: 0; // 0 = desactivado, 1 = toda la lista, 2 = una canción
    out property <bool> dragging: seek.dragging;
    // Diagnóstico del audio: clic en la línea de estado para alternar.
    in property <string> debug-text;
    in-out property <bool> show-debug: false;

    // --- Eventos hacia Rust ---
    callback pick-folder();
    callback select-folder(int);
    callback remove-folder(int);
    callback search-changed(string);
    callback edit-track(int);
    callback edit-pick-cover();
    callback edit-remove-cover();
    callback edit-save();
    callback edit-save-local();
    callback edit-cancel();
    callback theme-changed(bool);
    callback minimize-to-tray();
    callback play-index(int);
    callback toggle-play();
    callback next-track();
    callback previous-track();
    callback seek(float);
    callback set-volume(float);
    callback normalize-changed(bool);
    callback crossfade-changed(int);
    callback toggle-shuffle();
    callback cycle-repeat();

    HorizontalLayout {
        padding: 32px;
        spacing: 36px;

        // ---------- Reproductor principal ----------
        VerticalLayout {
            width: 340px;
            spacing: 20px;
            alignment: center;

            HorizontalLayout {
                alignment: center;
                SpinningDisc {
                    cover: root.current-cover;
                    has-cover: root.has-cover;
                    spinning: root.playing;
                }
            }

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: root.current-title;
                    color: Theme.text;
                    font-size: 21px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: root.current-artist;
                    color: Theme.text-dim;
                    font-size: 14px;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }

            VerticalLayout {
                spacing: 4px;
                seek := NeuSlider {
                    value <=> root.progress;
                    released(v) => {
                        root.seek(v);
                    }
                }
                HorizontalLayout {
                    Text {
                        text: root.position-text;
                        color: Theme.text-dim;
                        font-size: 12px;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.duration-text;
                        color: Theme.text-dim;
                        font-size: 12px;
                    }
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 14px;

                // Aleatorio
                NeuButton {
                    size: 46px;
                    active: root.shuffle;
                    clicked => {
                        root.toggle-shuffle();
                    }
                    Rectangle {
                        Path {
                            x: (parent.width - 22px) / 2;
                            y: (parent.height - 16px) / 2;
                            width: 22px;
                            height: 16px;
                            viewbox-width: 22;
                            viewbox-height: 16;
                            commands: "M 0 3 L 5 3 C 10 3 11 13 16 13 L 19 13 M 0 13 L 5 13 C 10 13 11 3 16 3 L 19 3";
                            stroke: root.shuffle ? Theme.accent : Theme.text-dim;
                            stroke-width: 2px;
                        }
                        Path {
                            x: (parent.width - 22px) / 2;
                            y: (parent.height - 16px) / 2;
                            width: 22px;
                            height: 16px;
                            viewbox-width: 22;
                            viewbox-height: 16;
                            commands: "M 17 0 L 22 3 L 17 6 Z M 17 10 L 22 13 L 17 16 Z";
                            fill: root.shuffle ? Theme.accent : Theme.text-dim;
                        }
                    }
                }

                // Anterior
                NeuButton {
                    size: 56px;
                    clicked => {
                        root.previous-track();
                    }
                    Path {
                        x: (parent.width - 18px) / 2;
                        y: (parent.height - 18px) / 2;
                        width: 18px;
                        height: 18px;
                        viewbox-width: 18;
                        viewbox-height: 18;
                        commands: "M 0 0 L 4 0 L 4 18 L 0 18 Z M 18 0 L 6 9 L 18 18 Z";
                        fill: Theme.text;
                    }
                }

                // Reproducir / pausar
                NeuButton {
                    size: 74px;
                    clicked => {
                        root.toggle-play();
                    }
                    if !root.playing: Path {
                        x: (parent.width - 20px) / 2 + 2px;
                        y: (parent.height - 24px) / 2;
                        width: 20px;
                        height: 24px;
                        viewbox-width: 20;
                        viewbox-height: 24;
                        commands: "M 0 0 L 20 12 L 0 24 Z";
                        fill: Theme.accent;
                    }
                    if root.playing: Path {
                        x: (parent.width - 20px) / 2;
                        y: (parent.height - 24px) / 2;
                        width: 20px;
                        height: 24px;
                        viewbox-width: 20;
                        viewbox-height: 24;
                        commands: "M 0 0 L 7 0 L 7 24 L 0 24 Z M 13 0 L 20 0 L 20 24 L 13 24 Z";
                        fill: Theme.accent;
                    }
                }

                // Siguiente
                NeuButton {
                    size: 56px;
                    clicked => {
                        root.next-track();
                    }
                    Path {
                        x: (parent.width - 18px) / 2;
                        y: (parent.height - 18px) / 2;
                        width: 18px;
                        height: 18px;
                        viewbox-width: 18;
                        viewbox-height: 18;
                        commands: "M 0 0 L 12 9 L 0 18 Z M 14 0 L 18 0 L 18 18 L 14 18 Z";
                        fill: Theme.text;
                    }
                }

                // Repetir (desactivado / toda la lista / una canción)
                NeuButton {
                    size: 46px;
                    active: root.repeat-mode != 0;
                    clicked => {
                        root.cycle-repeat();
                    }
                    Rectangle {
                        Path {
                            x: (parent.width - 22px) / 2;
                            y: (parent.height - 18px) / 2;
                            width: 22px;
                            height: 18px;
                            viewbox-width: 22;
                            viewbox-height: 18;
                            commands: "M 3 9 L 3 8 C 3 5 5 3 8 3 L 16 3 M 19 9 L 19 10 C 19 13 17 15 14 15 L 6 15";
                            stroke: root.repeat-mode != 0 ? Theme.accent : Theme.text-dim;
                            stroke-width: 2px;
                        }
                        Path {
                            x: (parent.width - 22px) / 2;
                            y: (parent.height - 18px) / 2;
                            width: 22px;
                            height: 18px;
                            viewbox-width: 22;
                            viewbox-height: 18;
                            commands: "M 15 0 L 20 3 L 15 6 Z M 7 12 L 2 15 L 7 18 Z";
                            fill: root.repeat-mode != 0 ? Theme.accent : Theme.text-dim;
                        }
                        if root.repeat-mode == 2: Text {
                            text: "1";
                            color: Theme.accent;
                            font-size: 9px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Volumen
            HorizontalLayout {
                spacing: 12px;
                padding-top: 6px;
                Path {
                    width: 18px;
                    height: 16px;
                    y: 4px;
                    viewbox-width: 18;
                    viewbox-height: 16;
                    commands: "M 0 5 L 4 5 L 9 0 L 9 16 L 4 11 L 0 11 Z M 12 4 C 14.5 6.5 14.5 9.5 12 12";
                    fill: Theme.text-dim;
                    stroke: Theme.text-dim;
                    stroke-width: 1.5px;
                }
                NeuSlider {
                    horizontal-stretch: 1;
                    value <=> root.volume;
                    moved(v) => {
                        root.set-volume(v);
                    }
                }
            }

            // Normalización de volumen y crossfade.
            VerticalLayout {
                spacing: 10px;
                padding-top: 4px;
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        horizontal-stretch: 1;
                        text: "Normalizar volumen";
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    NeuSwitch {
                        on: root.normalize;
                        toggled => {
                            root.normalize = !root.normalize;
                            root.normalize-changed(root.normalize);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        horizontal-stretch: 1;
                        text: "Crossfade";
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    MiniButton {
                        label: "−";
                        clicked => {
                            if (root.crossfade-secs > 0) {
                                root.crossfade-secs = root.crossfade-secs - 1;
                                root.crossfade-changed(root.crossfade-secs);
                            }
                        }
                    }
                    Text {
                        width: 48px;
                        text: root.crossfade-secs == 0 ? "No" : "" + root.crossfade-secs + " s";
                        color: root.crossfade-secs == 0 ? Theme.text-dim : Theme.accent;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    MiniButton {
                        label: "+";
                        clicked => {
                            if (root.crossfade-secs < 12) {
                                root.crossfade-secs = root.crossfade-secs + 1;
                                root.crossfade-changed(root.crossfade-secs);
                            }
                        }
                    }
                }
            }
        }

        // ---------- Biblioteca ----------
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 18px;

            HorizontalLayout {
                spacing: 18px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "Acustia Player";
                        color: Theme.text;
                        font-size: 26px;
                        font-weight: 800;
                    }
                    Text {
                        text: root.folder-name;
                        color: Theme.text-dim;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                NeuPill {
                    label: "Añadir carpeta";
                    clicked => {
                        root.pick-folder();
                    }
                }

                // Tema claro / oscuro: muestra una luna en claro y un sol en oscuro.
                NeuButton {
                    size: 44px;
                    clicked => {
                        Theme.dark = !Theme.dark;
                        root.theme-changed(Theme.dark);
                    }
                    if !Theme.dark: Path {
                        x: (parent.width - 18px) / 2;
                        y: (parent.height - 18px) / 2;
                        width: 18px;
                        height: 18px;
                        viewbox-width: 18;
                        viewbox-height: 18;
                        commands: "M 9 1 A 8 8 0 0 0 9 17 A 10 10 0 0 1 9 1 Z";
                        fill: Theme.text;
                    }
                    if Theme.dark: Path {
                        x: (parent.width - 18px) / 2;
                        y: (parent.height - 18px) / 2;
                        width: 18px;
                        height: 18px;
                        viewbox-width: 18;
                        viewbox-height: 18;
                        commands: "M 9 5.5 A 3.5 3.5 0 1 1 9 12.5 A 3.5 3.5 0 1 1 9 5.5 Z M 9 0.5 L 9 2.5 M 9 15.5 L 9 17.5 M 0.5 9 L 2.5 9 M 15.5 9 L 17.5 9 M 3 3 L 4.4 4.4 M 13.6 13.6 L 15 15 M 15 3 L 13.6 4.4 M 4.4 13.6 L 3 15";
                        fill: Theme.text;
                        stroke: Theme.text;
                        stroke-width: 1.5px;
                    }
                }

                // Minimizar a la bandeja del sistema.
                NeuButton {
                    size: 44px;
                    clicked => {
                        root.minimize-to-tray();
                    }
                    Path {
                        x: (parent.width - 18px) / 2;
                        y: (parent.height - 18px) / 2;
                        width: 18px;
                        height: 18px;
                        viewbox-width: 18;
                        viewbox-height: 18;
                        commands: "M 3 3 L 9 9 L 15 3 M 2 15 L 16 15";
                        stroke: Theme.text;
                        stroke-width: 2px;
                    }
                }
            }

            // Carpetas: una pestaña por carpeta, la reproducción se alterna entre ellas.
            if root.folders.length > 0: Flickable {
                height: 50px;
                content-width: root.folders.length * 176px;
                for folder[i] in root.folders: FolderChip {
                    x: i * 176px;
                    y: 3px;
                    item: folder;
                    selected: i == root.selected-folder;
                    activated => {
                        root.select-folder(i);
                    }
                    removed => {
                        root.remove-folder(i);
                    }
                }
            }

            // Búsqueda.
            NeuInset {
                height: 42px;
                radius: 21px;
                Path {
                    x: 16px;
                    y: (parent.height - 16px) / 2;
                    width: 16px;
                    height: 16px;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    commands: "M 6.5 1.5 A 5 5 0 1 1 6.5 11.5 A 5 5 0 1 1 6.5 1.5 Z M 10.5 10.5 L 15 15";
                    stroke: Theme.text-dim;
                    stroke-width: 1.8px;
                }
                if root.search-text == "": Text {
                    x: 44px;
                    width: parent.width - 90px;
                    text: "Buscar canciones…";
                    color: Theme.text-dim;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                search-input := TextInput {
                    x: 44px;
                    y: (parent.height - self.preferred-height) / 2;
                    width: parent.width - 90px;
                    text <=> root.search-text;
                    color: Theme.text;
                    font-size: 14px;
                    single-line: true;
                    edited => {
                        root.search-changed(self.text);
                    }
                }
                if root.search-text != "": Rectangle {
                    x: parent.width - 38px;
                    y: (parent.height - 28px) / 2;
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: clear-ta.has-hover ? Theme.row-current : transparent;
                    Path {
                        x: (parent.width - 10px) / 2;
                        y: (parent.height - 10px) / 2;
                        width: 10px;
                        height: 10px;
                        viewbox-width: 10;
                        viewbox-height: 10;
                        commands: "M 1 1 L 9 9 M 9 1 L 1 9";
                        stroke: Theme.text-dim;
                        stroke-width: 1.5px;
                    }
                    clear-ta := TouchArea {
                        clicked => {
                            root.search-text = "";
                            root.search-changed("");
                        }
                    }
                }
            }

            NeuInset {
                vertical-stretch: 1;
                radius: 22px;

                if root.tracks.length == 0: Text {
                    text: root.empty-text;
                    color: Theme.text-dim;
                    font-size: 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if root.tracks.length > 0: ListView {
                    x: 10px;
                    y: 10px;
                    width: parent.width - 20px;
                    height: parent.height - 20px;
                    for track in root.tracks: TrackRow {
                        item: track;
                        activated => {
                            root.play-index(track.index);
                        }
                        edit => {
                            root.edit-track(track.index);
                        }
                    }
                }
            }

            Rectangle {
                height: 18px;
                Text {
                    text: root.show-debug ? root.debug-text : root.status-message;
                    color: Theme.text-dim;
                    font-size: 12px;
                    overflow: elide;
                }
                TouchArea {
                    clicked => {
                        root.show-debug = !root.show-debug;
                    }
                }
            }
        }
    }

    // ---------- Editar metadatos de una canción ----------
    if root.editing: Rectangle {
        width: root.width;
        height: root.height;
        background: #00000066;
        // Absorbe los clics para que no lleguen a la lista de debajo.
        TouchArea {}

        NeuRaised {
            width: min(540px, parent.width - 48px);
            height: min(470px, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            radius: 24px;
            depth: 8px;

            VerticalLayout {
                padding: 24px;
                spacing: 10px;
                Text {
                    text: "Editar metadatos";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: root.edit-file;
                    color: Theme.text-dim;
                    font-size: 12px;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 18px;
                    // Carátula
                    VerticalLayout {
                        width: 132px;
                        spacing: 6px;
                        alignment: start;
                        NeuInset {
                            width: 132px;
                            height: 132px;
                            radius: 16px;
                            Rectangle {
                                x: 4px;
                                y: 4px;
                                width: parent.width - 8px;
                                height: parent.height - 8px;
                                border-radius: 12px;
                                clip: true;
                                if root.edit-has-cover: Image {
                                    source: root.edit-cover;
                                    image-fit: cover;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                if !root.edit-has-cover: Text {
                                    text: "♪";
                                    color: Theme.text-dim;
                                    font-size: 48px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        TextButton {
                            label: "Cambiar carátula…";
                            clicked => {
                                if (!root.edit-busy) {
                                    root.edit-pick-cover();
                                }
                            }
                        }
                        if root.edit-has-cover: TextButton {
                            label: "Quitar carátula";
                            clicked => {
                                if (!root.edit-busy) {
                                    root.edit-remove-cover();
                                }
                            }
                        }
                    }
                    // Campos
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        NeuField {
                            label: "Título";
                            value <=> root.edit-title;
                            disabled: root.edit-busy;
                            accepted => {
                                root.edit-save();
                            }
                            escaped => {
                                root.editing = false;
                                root.edit-cancel();
                            }
                        }
                        NeuField {
                            label: "Artista";
                            value <=> root.edit-artist;
                            disabled: root.edit-busy;
                            accepted => {
                                root.edit-save();
                            }
                            escaped => {
                                root.editing = false;
                                root.edit-cancel();
                            }
                        }
                        NeuField {
                            label: "Álbum";
                            value <=> root.edit-album;
                            disabled: root.edit-busy;
                            accepted => {
                                root.edit-save();
                            }
                            escaped => {
                                root.editing = false;
                                root.edit-cancel();
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            NeuField {
                                horizontal-stretch: 1;
                                label: "Género";
                                value <=> root.edit-genre;
                                disabled: root.edit-busy;
                                accepted => {
                                    root.edit-save();
                                }
                                escaped => {
                                    root.editing = false;
                                    root.edit-cancel();
                                }
                            }
                            NeuField {
                                width: 90px;
                                label: "Año";
                                value <=> root.edit-year;
                                disabled: root.edit-busy;
                                accepted => {
                                    root.edit-save();
                                }
                                escaped => {
                                    root.editing = false;
                                    root.edit-cancel();
                                }
                            }
                        }
                    }
                }
                Text {
                    text: root.edit-error;
                    color: #d9534f;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle {
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    if root.edit-error != "": NeuPill {
                        label: "Solo en la app";
                        min-width: 120px;
                        clicked => {
                            root.edit-save-local();
                        }
                    }
                    NeuPill {
                        label: "Cancelar";
                        min-width: 110px;
                        clicked => {
                            root.editing = false;
                            root.edit-cancel();
                        }
                    }
                    NeuPill {
                        label: root.edit-busy ? "Espere…" : "Guardar";
                        min-width: 110px;
                        clicked => {
                            root.edit-save();
                        }
                    }
                }
            }
        }
    }
}
