// Acustia Player v0.0.1 Alpha — interfaz neumórfica.
// Neumorfismo: superficies del mismo color que el fondo, con una sombra clara
// arriba-izquierda y otra oscura abajo-derecha. Slint admite una sola sombra
// por elemento, así que se anidan dos rectángulos (ver NeuRaised).
import { Button, CheckBox, LineEdit, ComboBox } from "std-widgets.slint";
import { ListView } from "std-widgets.slint";
export global Theme {
    // false = tema claro (blanco), true = tema oscuro (negro). Solo indica el modo base
    // (iconos, interruptor); los colores los calcula Rust (modo + acento + tinte + Ambient
    // Light) y los escribe aquí. Los valores iniciales son la paleta clara original.
    in-out property <bool> dark: false;
    // Duración (ms) del fundido entre paletas. Empieza en 0 para que al abrir la app no se
    // vea un destello de claro a oscuro; Rust lo sube a 600 tras el primer fotograma.
    // NOTA: Slint no permite 'animate' dentro de un 'global'. El cambio de paleta
    // ahora es instantáneo. Esta propiedad se mantiene porque Rust la escribe.
    in-out property <int> fade-ms: 0;

    in-out property <color> bg: #e4e8ef;
    in-out property <color> light: #ffffff;
    in-out property <color> shadow: #b9c1d1;
    in-out property <color> text: #3b4256;
    in-out property <color> text-dim: #8c95aa;
    in-out property <color> accent: #6577f5;
    in-out property <color> inset-top: #d3d9e4;
    in-out property <color> inset-bottom: #eef1f6;
    in-out property <color> inset-border: #ffffff80;
    in-out property <color> row-current: #d9deea;
    in-out property <color> row-hover: #00000008;
    // Resplandor de Ambient Light tras el CD (transparente si está desactivado).
    in-out property <color> glow: #6577f500;
    in-out property <color> glow-fade: #6577f500;
}

export struct TrackItem {
    // Posición de la canción en su carpeta (con la búsqueda activa la lista
    // mostrada es un subconjunto, así que no coincide con la fila).
    index: int,
    title: string,
    subtitle: string,
    duration: string,
    cover: image,
    has-cover: bool,
    current: bool,
    // El usuario le cambió el nombre (solo se ve en la app; el archivo no se toca).
    edited: bool,
    // Marcada como favorita (estrella).
    favorite: bool,
}

export struct HistoryItem {
    title: string,
    // «Artista · hace 5 min».
    subtitle: string,
    // La canción sigue en alguna de las carpetas (se puede volver a reproducir).
    available: bool,
}

// Fila «etiqueta — valor» de las estadísticas.
export struct StatRow {
    label: string,
    value: string,
}

export struct FolderItem {
    name: string,
    // Carpeta en modo podcast (cassette en vez de CD).
    podcast: bool,
    count: int,
    // La reproducción en curso viene de esta carpeta.
    playing: bool,
    // La carpeta ya no existe en el disco.
    missing: bool,
    // Ya se leyó (el gadget solo deja elegir carpetas cargadas).
    loaded: bool,
}

// Superficie en relieve.
component NeuRaised inherits Rectangle {
    in property <length> radius: 18px;
    in property <length> depth: 6px;
    background: Theme.bg;
    border-radius: root.radius;
    drop-shadow-color: Theme.light;
    drop-shadow-blur: root.depth * 2;
    drop-shadow-offset-x: -root.depth;
    drop-shadow-offset-y: -root.depth;

    Rectangle {
        background: Theme.bg;
        border-radius: root.radius;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: root.depth * 2;
        drop-shadow-offset-x: root.depth;
        drop-shadow-offset-y: root.depth;
        @children
    }
}

// Superficie hundida (aproximación con degradado).
component NeuInset inherits Rectangle {
    in property <length> radius: 18px;
    border-radius: root.radius;
    background: @linear-gradient(135deg, Theme.inset-top 0%, Theme.inset-bottom 100%);
    border-width: 1px;
    border-color: Theme.inset-border;
}

// Botón redondo; al pulsarse o estar activo "se hunde".
component NeuButton inherits Rectangle {
    in property <length> size: 56px;
    in property <bool> active: false;
    callback clicked();
    width: root.size;
    height: root.size;

    NeuRaised {
        radius: root.size / 2;
        depth: (ta.pressed || root.active) ? 2px : 6px;
        @children
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Botón alargado con texto.
component NeuPill inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 44px;
    min-width: 150px;

    NeuRaised {
        radius: 22px;
        depth: ta.pressed ? 2px : 5px;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Interruptor encendido/apagado.
component NeuSwitch inherits Rectangle {
    in property <bool> on;
    callback toggled();
    width: 46px;
    height: 26px;

    NeuInset {
        radius: 13px;
    }
    Rectangle {
        x: root.on ? root.width - self.width - 3px : 3px;
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.on ? Theme.accent : Theme.text-dim;
        animate x { duration: 120ms; }
    }
    TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

// Botón redondo pequeño con un texto (− / +).
component MiniButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: 30px;
    height: 30px;

    NeuRaised {
        radius: 15px;
        depth: ta.pressed ? 1px : 3px;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: 16px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// CD neumórfico: gira mientras `spinning` y muestra la carátula como etiqueta del disco.
component SpinningDisc inherits Rectangle {
    in property <image> cover;
    in property <bool> has-cover;
    in property <bool> spinning;
    property <angle> angle: 0deg;
    width: 270px;
    height: 270px;

    // ~73°/s (una vuelta cada 5 s) a 30 fotogramas por segundo, solo mientras suena.
    Timer {
        interval: 33ms;
        running: root.spinning;
        triggered => {
            root.angle = root.angle + 2.4deg;
            if (root.angle >= 360deg) {
                root.angle = root.angle - 360deg;
            }
        }
    }

    // Ambient Light: resplandor del color de la carátula alrededor del CD. Va en una capa
    // con caché para que el desenfoque no se recalcule en cada fotograma del giro.
    Rectangle {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: parent.height - 20px;
        border-radius: self.width / 2;
        background: Theme.glow;
        drop-shadow-color: Theme.glow;
        drop-shadow-blur: 90px;
        cache-rendering-hint: true;
    }

    // Relieve neumórfico circular.
    NeuRaised {
        radius: root.width / 2;
        depth: 10px;

        // Disco (recortado en círculo).
        Rectangle {
            x: 14px;
            y: 14px;
            width: parent.width - 28px;
            height: parent.height - 28px;
            border-radius: self.width / 2;
            clip: true;
            background: Theme.inset-top;

            // Sin carátula: disco plateado (asimétrico para que se vea el giro).
if !root.has-cover: Image {
    source: @image-url("../assets/disc-blank.png");
    image-fit: ImageFit.cover;
    width: parent.width;
    height: parent.height;
    transform-rotation: root.angle;
}
            if root.has-cover: Image {
                source: root.cover;
                image-fit: ImageFit.cover;
                width: parent.width;
                height: parent.height;
                transform-rotation: root.angle;
            }

            // Capas fijas (no giran): brillo de la luz y borde del disco.
            Rectangle {
                background: @linear-gradient(135deg, #ffffff40 0%, #ffffff00 38%, #00000000 62%, #00000030 100%);
            }
            Rectangle {
                border-radius: self.width / 2;
                border-width: 2px;
                border-color: #ffffff33;
            }
            // Anillo interior de datos (el borde de la zona grabada).
            Rectangle {
                x: parent.width * 0.30;
                y: parent.height * 0.30;
                width: parent.width * 0.40;
                height: parent.height * 0.40;
                border-radius: self.width / 2;
                border-width: 1px;
                border-color: #ffffff2a;
            }
            // Cubo central con el agujero.
            Rectangle {
                x: (parent.width - 76px) / 2;
                y: (parent.height - 76px) / 2;
                width: 76px;
                height: 76px;
                border-radius: 38px;
                background: @linear-gradient(135deg, Theme.light 0%, Theme.shadow 100%);
                border-width: 2px;
                border-color: #ffffff40;
                Rectangle {
                    x: (parent.width - 26px) / 2;
                    y: (parent.height - 26px) / 2;
                    width: 26px;
                    height: 26px;
                    border-radius: 13px;
                    background: Theme.bg;
                    border-width: 2px;
                    border-color: #00000040;
                }
            }
        }
    }
}

// Casilla pequeña con etiqueta.
component NeuCheck inherits Rectangle {
    in property <string> label;
    in property <bool> checked: false;
    callback toggled();
    height: 28px;
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 22px;
            height: 22px;
            y: 3px;
            NeuInset {
                radius: 7px;
                if root.checked: Path {
                    x: (parent.width - 12px) / 2;
                    y: (parent.height - 10px) / 2;
                    width: 12px;
                    height: 10px;
                    viewbox-width: 12;
                    viewbox-height: 10;
                    commands: "M 1 5 L 4.5 8.5 L 11 1.5";
                    stroke: Theme.accent;
                    stroke-width: 2.2px;
                }
            }
        }
        Text {
            text: root.label;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

// Cassette (modo podcast): las dos bobinas giran y la cinta pasa de una a otra según el
// progreso de la canción. Mismo tamaño (270×270) que el CD para poder intercambiarlos.
component Cassette inherits Rectangle {
    in property <image> cover;
    in property <bool> has-cover;
    in property <bool> spinning;
    // Progreso 0–1 del episodio: la bobina izquierda se vacía y la derecha se llena.
    in property <float> progress: 0;
    property <angle> angle: 0deg;
    // Radio de las bobinas de cinta (mín. = cubo vacío).
    property <length> left-r: 15px + 14px * (1 - clamp(root.progress, 0, 1));
    property <length> right-r: 15px + 14px * clamp(root.progress, 0, 1);
    width: 270px;
    height: 270px;

    // Las bobinas giran en sentido antihorario, ~100°/s.
    Timer {
        interval: 33ms;
        running: root.spinning;
        triggered => {
            root.angle = root.angle - 3.2deg;
            if (root.angle <= -360deg) {
                root.angle = root.angle + 360deg;
            }
        }
    }

    // Ambient Light tras el cassette.
    Rectangle {
        x: 24px;
        y: 62px;
        width: parent.width - 48px;
        height: 146px;
        border-radius: 30px;
        background: Theme.glow;
        drop-shadow-color: Theme.glow;
        drop-shadow-blur: 90px;
        cache-rendering-hint: true;
    }

    // Cuerpo del cassette.
    NeuRaised {
        x: 5px;
        y: 51px;
        width: 260px;
        height: 168px;
        radius: 16px;
        depth: 8px;

        Rectangle {
            border-radius: 16px;
            background: @linear-gradient(135deg, Theme.light 0%, Theme.shadow 100%);
            clip: true;

            // Etiqueta (con la carátula si hay).
            Rectangle {
                x: 18px;
                y: 12px;
                width: parent.width - 36px;
                height: 50px;
                border-radius: 6px;
                background: Theme.bg;
                clip: true;
                if root.has-cover: Image {
                    source: root.cover;
                    image-fit: ImageFit.cover;
                    width: parent.width;
                    height: parent.height;
                    opacity: 0.55;
                }
                // Líneas de la etiqueta.
                Rectangle {
                    x: 12px;
                    y: 16px;
                    width: parent.width - 24px;
                    height: 1px;
                    background: Theme.text-dim;
                }
                Rectangle {
                    x: 12px;
                    y: 32px;
                    width: parent.width - 24px;
                    height: 1px;
                    background: Theme.text-dim;
                }
                Text {
                    x: 12px;
                    y: 3px;
                    text: "PODCAST";
                    color: Theme.accent;
                    font-size: 10px;
                    font-weight: 800;
                    letter-spacing: 2px;
                }
            }

            // Ventana de la cinta.
            Rectangle {
                x: 28px;
                y: 72px;
                width: parent.width - 56px;
                height: 62px;
                border-radius: 31px;
                background: #1c1816;
                border-width: 2px;
                border-color: #00000055;
                clip: true;

                // Cinta tendida entre las dos bobinas.
                Rectangle {
                    x: 42px;
                    y: parent.height - 12px;
                    width: parent.width - 84px;
                    height: 2px;
                    background: #5a4a40;
                }
                // Paquete de cinta izquierdo.
                Rectangle {
                    x: 42px - root.left-r;
                    y: parent.height / 2 - root.left-r - 1px;
                    width: root.left-r * 2;
                    height: root.left-r * 2;
                    border-radius: root.left-r;
                    background: #3a2f29;
                }
                // Paquete de cinta derecho.
                Rectangle {
                    x: parent.width - 42px - root.right-r;
                    y: parent.height / 2 - root.right-r - 1px;
                    width: root.right-r * 2;
                    height: root.right-r * 2;
                    border-radius: root.right-r;
                    background: #3a2f29;
                }
                // Cubos con radios: giran.
                for k in 2: Rectangle {
                    x: (k == 0 ? 42px : parent.width - 42px) - 13px;
                    y: parent.height / 2 - 14px;
                    width: 26px;
                    height: 26px;
                    border-radius: 13px;
                    background: #e9e6e0;
                    transform-rotation: root.angle;
                    Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-width: 26;
                        viewbox-height: 26;
                        commands: "M 13 13 L 13 3 M 13 13 L 21.7 18 M 13 13 L 4.3 18";
                        stroke: #6d675f;
                        stroke-width: 3px;
                    }
                    Rectangle {
                        x: 8px;
                        y: 8px;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: #1c1816;
                    }
                }
            }

            // Tornillos.
            for k in 4: Rectangle {
                x: (mod(k, 2) == 0 ? 6px : parent.width - 14px);
                y: (k < 2 ? 6px : parent.height - 14px);
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.shadow;
            }
            // Brillo fijo.
            Rectangle {
                background: @linear-gradient(135deg, #ffffff30 0%, #ffffff00 40%);
            }
        }
    }
}

// Arte de la reproducción: CD o cassette según el modo de la carpeta que suena.
component MediaArt inherits Rectangle {
    in property <image> cover;
    in property <bool> has-cover;
    in property <bool> spinning;
    in property <bool> podcast;
    in property <float> progress: 0;
    width: 270px;
    height: 270px;
    if !root.podcast: SpinningDisc {
        cover: root.cover;
        has-cover: root.has-cover;
        spinning: root.spinning;
    }
    if root.podcast: Cassette {
        cover: root.cover;
        has-cover: root.has-cover;
        spinning: root.spinning;
        progress: root.progress;
    }
}

// Campo de texto con etiqueta.
component NeuField inherits Rectangle {
    in property <string> label;
    in-out property <string> value;
    in property <bool> disabled: false;
    callback accepted();
    callback escaped();
    height: 58px;

    VerticalLayout {
        spacing: 3px;
        Text {
            text: root.label;
            color: Theme.text-dim;
            font-size: 11px;
        }
        NeuInset {
            height: 36px;
            radius: 12px;
            TextInput {
                x: 12px;
                y: (parent.height - self.preferred-height) / 2;
                width: parent.width - 24px;
                text <=> root.value;
                read-only: root.disabled;
                color: root.disabled ? Theme.text-dim : Theme.text;
                font-size: 14px;
                single-line: true;
                accepted => {
                    root.accepted();
                }
                key-pressed(e) => {
                    if (e.text == Key.Escape) {
                        root.escaped();
                        return accept;
                    }
                    return reject;
                }
            }
        }
    }
}

// Botón de texto (enlace).
component TextButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 26px;
    Text {
        text: root.label;
        color: ta.has-hover ? Theme.accent : Theme.text-dim;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Deslizador (progreso y volumen). `value` va de 0 a 1.
component NeuSlider inherits Rectangle {
    in-out property <float> value: 0;
    out property <bool> dragging: ta.pressed;
    callback moved(float);
    callback released(float);
    callback dragging-changed(bool);
    height: 24px;

    function fraction(x: length) -> float {
        return max(0.0, min(1.0, x / root.width));
    }

    NeuInset {
        y: (root.height - 10px) / 2;
        height: 10px;
        radius: 5px;
        Rectangle {
            x: 0px;
            width: parent.width * max(0.0, min(1.0, root.value));
            border-radius: 5px;
            background: Theme.accent;
        }
    }

    NeuRaised {
        width: 22px;
        height: 22px;
        radius: 11px;
        depth: 3px;
        x: (root.width - self.width) * max(0.0, min(1.0, root.value));
        y: (root.height - self.height) / 2;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.accent;
        }
    }

    ta := TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) {
                    root.dragging-changed(true);
                    root.value = root.fraction(self.mouse-x);
                    root.moved(root.value);
                } else if (e.kind == PointerEventKind.up) {
                    root.dragging-changed(false);
                    root.released(root.value);
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.value = root.fraction(self.mouse-x);
                root.moved(root.value);
            }
        }
    }
}

// Botón plano redondo del gadget (sin relieve: ocupa poco y se parece a un mini reproductor).
component GadgetButton inherits Rectangle {
    in property <length> size: 30px;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: ta.has-hover ? Theme.row-hover : transparent;
    @children
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Barra de progreso fina del gadget.
component GadgetSlider inherits Rectangle {
    in-out property <float> value: 0;
    callback released(float);
    callback dragging-changed(bool);
    height: 14px;

    function fraction(x: length) -> float {
        return max(0.0, min(1.0, x / root.width));
    }

    Rectangle {
        y: (parent.height - 3px) / 2;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.text-dim;
        opacity: 0.35;
    }
    Rectangle {
        y: (parent.height - 3px) / 2;
        width: parent.width * max(0.0, min(1.0, root.value));
        height: 3px;
        border-radius: 1.5px;
        background: Theme.text;
    }
    Rectangle {
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.text;
        x: (root.width - self.width) * max(0.0, min(1.0, root.value));
        y: (root.height - self.height) / 2;
    }
    TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) {
                    root.dragging-changed(true);
                    root.value = root.fraction(self.mouse-x);
                } else if (e.kind == PointerEventKind.up) {
                    root.dragging-changed(false);
                    root.released(root.value);
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.value = root.fraction(self.mouse-x);
            }
        }
    }
}

// Banda del ecualizador: deslizador vertical de −12 a +12 dB.
component EqBand inherits Rectangle {
    in property <string> label;
    in property <string> gain-text;
    // Ganancia actual en dB.
    in property <float> gain;
    in property <bool> active: true;
    callback band-moved(float);
    width: 46px;

    function value-at(y: length) -> float {
        return 12.0 - 24.0 * max(0.0, min(1.0, (y - 11px) / (track.height - 22px)));
    }

    VerticalLayout {
        spacing: 8px;
        Text {
            text: root.gain-text;
            color: root.gain == 0 ? Theme.text-dim : Theme.accent;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        track := Rectangle {
            vertical-stretch: 1;
            opacity: root.active ? 1.0 : 0.45;

            NeuInset {
                x: (parent.width - 10px) / 2;
                width: 10px;
                radius: 5px;
            }
            // Línea de 0 dB.
            Rectangle {
                y: parent.height / 2 - 0.5px;
                width: parent.width;
                height: 1px;
                background: Theme.text-dim;
                opacity: 0.35;
            }
            NeuRaised {
                width: 22px;
                height: 22px;
                radius: 11px;
                depth: 3px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) * (1.0 - (root.gain + 12.0) / 24.0);
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                }
            }
            band-ta := TouchArea {
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                        root.band-moved(root.value-at(self.mouse-y));
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.band-moved(root.value-at(self.mouse-y));
                    }
                }
            }
        }
        Text {
            text: root.label;
            color: Theme.text-dim;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }
}

// Muestra de color de un tema (círculo con el acento del preset).
component Swatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> selected;
    callback activated();
    width: 38px;
    height: 38px;

    if root.selected: NeuInset {
        radius: 19px;
    }
    if !root.selected: NeuRaised {
        radius: 19px;
        depth: 3px;
    }
    Rectangle {
        x: (parent.width - 22px) / 2;
        y: (parent.height - 22px) / 2;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: root.swatch;
    }
    TouchArea {
        clicked => {
            root.activated();
        }
    }
}

// Preset del ecualizador.
component PresetChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback activated();
    width: 142px;
    height: 38px;

    if root.selected: NeuInset {
        radius: 12px;
    }
    if !root.selected: NeuRaised {
        radius: 12px;
        depth: 3px;
    }
    Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.label;
        color: root.selected ? Theme.accent : Theme.text;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    TouchArea {
        clicked => {
            root.activated();
        }
    }
}

// Fila del historial de reproducción.
component HistoryRow inherits Rectangle {
    in property <HistoryItem> item;
    callback activated();
    height: 54px;
    border-radius: 12px;
    background: ta.has-hover && root.item.available ? Theme.row-hover : transparent;

    ta := TouchArea {
        clicked => {
            root.activated();
        }
    }
    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.item.title;
            color: root.item.available ? Theme.text : Theme.text-dim;
            font-size: 14px;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: root.item.subtitle;
            color: Theme.text-dim;
            font-size: 12px;
            overflow: elide;
        }
    }
}

component TrackRow inherits Rectangle {
    in property <TrackItem> item;
    callback activated();
    callback edit();
    callback toggle-favorite();
    height: 64px;
    border-radius: 14px;
    background: root.item.current ? Theme.row-current : (ta.has-hover ? Theme.row-hover : transparent);

    // Va antes que el contenido para que el botón de editar quede por encima.
    ta := TouchArea {
        clicked => {
            root.activated();
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 14px;

        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            clip: true;
            background: @linear-gradient(135deg, Theme.inset-top 0%, Theme.inset-bottom 100%);
            if root.item.has-cover: Image {
                source: root.item.cover;
                image-fit: ImageFit.cover;
                width: parent.width;
                height: parent.height;
            }
            if !root.item.has-cover: Text {
                text: "♪";
                color: Theme.text-dim;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.item.title;
                color: root.item.current ? Theme.accent : Theme.text;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.item.subtitle;
                color: Theme.text-dim;
                font-size: 12px;
                overflow: elide;
            }
        }

        Text {
            text: root.item.duration;
            color: Theme.text-dim;
            font-size: 13px;
            vertical-alignment: center;
        }

        // Favorito (estrella).
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 15px;
                background: fav-ta.has-hover ? Theme.row-current : transparent;
                Path {
                    x: (parent.width - 16px) / 2;
                    y: (parent.height - 16px) / 2;
                    width: 16px;
                    height: 16px;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    commands: "M 8 0.8 L 10.1 5.5 L 15.2 6.1 L 11.4 9.6 L 12.5 14.7 L 8 12.1 L 3.5 14.7 L 4.6 9.6 L 0.8 6.1 L 5.9 5.5 Z";
                    fill: root.item.favorite ? Theme.accent : transparent;
                    stroke: root.item.favorite ? Theme.accent : Theme.text-dim;
                    stroke-width: 1.4px;
                }
                fav-ta := TouchArea {
                    clicked => {
                        root.toggle-favorite();
                    }
                }
            }
        }

        // Editar el nombre mostrado.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 15px;
                background: edit-ta.has-hover ? Theme.row-current : transparent;
                Path {
                    x: (parent.width - 14px) / 2;
                    y: (parent.height - 14px) / 2;
                    width: 14px;
                    height: 14px;
                    viewbox-width: 14;
                    viewbox-height: 14;
                    commands: "M 1 13 L 1 10 L 10 1 L 13 4 L 4 13 Z M 8 3 L 11 6";
                    stroke: root.item.edited ? Theme.accent : Theme.text-dim;
                    stroke-width: 1.5px;
                }
                edit-ta := TouchArea {
                    clicked => {
                        root.edit();
                    }
                }
            }
        }
    }
}

// Pestaña de una carpeta.
component FolderChip inherits Rectangle {
    in property <FolderItem> item;
    in property <bool> selected;
    callback activated();
    callback removed();
    width: 168px;
    height: 44px;

    if root.selected: NeuInset {
        radius: 14px;
    }
    if !root.selected: NeuRaised {
        radius: 14px;
        depth: 3px;
    }

    ta := TouchArea {
        clicked => {
            root.activated();
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 6px;
        if root.item.playing: Text {
            text: "♪";
            color: Theme.accent;
            font-size: 14px;
            vertical-alignment: center;
        }
        if root.item.podcast: Text {
            text: "POD";
            color: Theme.accent;
            font-size: 9px;
            font-weight: 800;
            vertical-alignment: center;
        }
        if root.item.missing: Text {
            text: "⚠";
            color: Theme.text-dim;
            font-size: 14px;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.item.name;
            color: root.selected ? Theme.accent : Theme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: rm-ta.has-hover ? Theme.row-current : transparent;
                Path {
                    x: (parent.width - 10px) / 2;
                    y: (parent.height - 10px) / 2;
                    width: 10px;
                    height: 10px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    commands: "M 1 1 L 9 9 M 9 1 L 1 9";
                    stroke: Theme.text-dim;
                    stroke-width: 1.5px;
                }
                rm-ta := TouchArea {
                    clicked => {
                        root.removed();
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Acustia Player";
    icon: @image-url("../assets/icon-256.png");
    min-width: root.widget-mode ? 340px : 960px;
    min-height: root.widget-mode ? 150px : 600px;
    preferred-width: root.widget-mode ? 340px : 1060px;
    preferred-height: root.widget-mode ? 150px : 680px;
    background: Theme.bg;
    // Modo widget: ventana sin marco, opcionalmente siempre encima.
    no-frame: root.widget-mode;
    always-on-top: root.widget-mode && root.widget-on-top;

    // --- Modo widget, ajustes, podcast y estadísticas ---
    in-out property <bool> widget-mode: false;
    // Selector de carpetas del gadget abierto y cuántas carpetas cargadas hay.
    in-out property <bool> gadget-folders-open: false;
    in property <int> loaded-folder-count: 0;
    in property <bool> widget-on-top: false;
    in-out property <bool> settings-open: false;
    in-out property <bool> widget-on-start: false;
    in-out property <bool> autostart: false;
    in property <string> autostart-status;
    in-out property <bool> stats-open: false;
    // La carpeta seleccionada está en modo podcast.
    in property <bool> podcast-mode: false;
    // Lo que suena ahora viene de una carpeta en modo podcast (cassette en vez de CD).
    in property <bool> now-podcast: false;
    in property <[StatRow]> stats-summary;
    in property <[StatRow]> stats-top-tracks;
    in property <[StatRow]> stats-top-artists;
    // Alturas (0–1) de las barras de los últimos días, del más antiguo al más reciente.
    in property <[float]> stats-bars;
    in property <string> stats-bars-caption;

    // --- Datos (los rellena Rust) ---
    in property <[TrackItem]> tracks;
    in property <string> folder-name: "Ninguna carpeta seleccionada";
    in property <[FolderItem]> folders;
    in property <int> selected-folder: 0;
    // Texto que se muestra cuando la lista está vacía (leyendo, sin resultados…).
    in property <string> empty-text: "Añade una carpeta para ver tu música";
    in-out property <string> search-text;
    // Ver solo las canciones favoritas de la carpeta.
    in-out property <bool> favorites-only: false;
    // La canción que suena es favorita (corazón del gadget).
    in property <bool> current-favorite: false;
    // Paneles: audio (ecualizador y ReplayGain) e historial.
    in-out property <bool> audio-open: false;
    in-out property <bool> history-open: false;
    in-out property <bool> appearance-open: false;
    in property <[HistoryItem]> history-items;
    // Apariencia: Ambient Light, presets de color, acento y tinte, y atajos globales.
    in-out property <bool> ambient: true;
    // Ambient Light está aplicando ahora el color de una carátula (los controles manuales no tienen efecto).
    in property <bool> ambient-active: false;
    in property <[string]> theme-preset-names;
    in property <[color]> theme-preset-colors;
    // Preset activo (−1 = personalizado).
    in property <int> theme-preset: 0;
    in-out property <float> theme-hue: 0.644;
    in-out property <float> theme-tint: 0;
    in-out property <bool> hotkeys-enabled: true;
    in property <string> hotkeys-help;
    in property <string> hotkeys-status;
    in-out property <bool> eq-enabled: false;
    in property <[string]> eq-preset-names;
    // Preset que coincide con las bandas (−1 = personalizado).
    in property <int> eq-preset: -1;
    in property <string> eq-preset-label: "Plano";
    in property <[string]> eq-band-names;
    // Ganancia de cada banda en dB y su texto («+3.5»).
    in property <[float]> eq-gains;
    in property <[string]> eq-gain-texts;
    // ReplayGain: ganancia de álbum en vez de la de pista.
    in-out property <bool> replaygain-album: false;
    // Diálogo para editar los metadatos de una canción.
    in-out property <bool> editing: false;
    in property <string> edit-file;
    in-out property <string> edit-title;
    in-out property <string> edit-artist;
    in-out property <string> edit-album;
    in-out property <string> edit-genre;
    in-out property <string> edit-year;
    in property <image> edit-cover;
    in property <bool> edit-has-cover: false;
    // Leyendo o guardando: los campos no se pueden tocar.
    in property <bool> edit-busy: false;
    in property <string> edit-error;
    in property <string> status-message;
    in property <string> current-title: "Acustia Player";
    in property <string> current-artist: "Abre una carpeta con música";
    in property <image> current-cover;
    in property <bool> has-cover: false;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in-out property <float> progress: 0;
    in-out property <float> volume: 0.8;
    // Normalizar el volumen de cada canción y duración del crossfade (0 = desactivado).
    in-out property <bool> normalize: true;
    in-out property <int> crossfade-secs: 0;
    in property <bool> playing: false;
    in property <bool> shuffle: false;
    in property <int> repeat-mode: 0; // 0 = desactivado, 1 = toda la lista, 2 = una canción
    in-out property <bool> dragging: false;
    // Diagnóstico del audio: clic en la línea de estado para alternar.
    in property <string> debug-text;
    in-out property <bool> show-debug: false;

    // --- Eventos hacia Rust ---
    callback widget-toggle();
    callback gadget-pick-folder(int);
    callback widget-drag(length, length);
    callback widget-on-start-changed(bool);
    callback widget-on-top-changed(bool);
    callback autostart-changed(bool);
    callback podcast-changed(bool);
    callback stats-opened();
    callback stats-reset();
    callback pick-folder();
    callback select-folder(int);
    callback remove-folder(int);
    callback search-changed(string);
    callback toggle-favorite(int);
    callback toggle-current-favorite();
    callback favorites-only-changed(bool);
    callback history-opened();
    callback history-play(int);
    callback history-clear();
    callback eq-toggled(bool);
    callback eq-preset-selected(int);
    callback eq-band-changed(int, float);
    callback eq-reset();
    callback replaygain-album-changed(bool);
    callback edit-track(int);
    callback edit-pick-cover();
    callback edit-remove-cover();
    callback edit-save();
    callback edit-save-local();
    callback edit-cancel();
    callback theme-changed(bool);
    callback ambient-changed(bool);
    callback theme-preset-selected(int);
    callback theme-hue-changed(float);
    callback theme-tint-changed(float);
    callback theme-reset();
    callback hotkeys-changed(bool);
    callback minimize-to-tray();
    callback play-index(int);
    callback toggle-play();
    callback next-track();
    callback previous-track();
    callback seek(float);
    callback set-volume(float);
    callback normalize-changed(bool);
    callback crossfade-changed(int);
    callback toggle-shuffle();
    callback cycle-repeat();

    if !root.widget-mode: HorizontalLayout {
        width: root.width;
        height: root.height;
        padding: 32px;
        spacing: 36px;

        // ---------- Reproductor principal ----------
        VerticalLayout {
            width: 340px;
            spacing: 20px;
            alignment: center;

            HorizontalLayout {
                alignment: center;
                MediaArt {
                    cover: root.current-cover;
                    has-cover: root.has-cover;
                    spinning: root.playing;
                    podcast: root.now-podcast;
                    progress: root.progress;
                }
            }

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: root.current-title;
                    color: Theme.text;
                    font-size: 21px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: root.current-artist;
                    color: Theme.text-dim;
                    font-size: 14px;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }

            VerticalLayout {
                spacing: 4px;
                seek_slider := NeuSlider {
                    value <=> root.progress;
                    dragging-changed(value) => {
                        root.dragging = value;
                    }
                    released(v) => {
                        root.seek(v);
                    }
                }
                HorizontalLayout {
                    Text {
                        text: root.position-text;
                        color: Theme.text-dim;
                        font-size: 12px;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.duration-text;
                        color: Theme.text-dim;
                        font-size: 12px;
                    }
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 14px;

                // Aleatorio
                NeuButton {
                    size: 46px;
                    active: root.shuffle;
                    clicked => {
                        root.toggle-shuffle();
                    }
                    Rectangle {
                        Path {
                            x: (parent.width - 22px) / 2;
                            y: (parent.height - 16px) / 2;
                            width: 22px;
                            height: 16px;
                            viewbox-width: 22;
                            viewbox-height: 16;
                            commands: "M 0 3 L 5 3 C 10 3 11 13 16 13 L 19 13 M 0 13 L 5 13 C 10 13 11 3 16 3 L 19 3";
                            stroke: root.shuffle ? Theme.accent : Theme.text-dim;
                            stroke-width: 2px;
                        }
                        Path {
                            x: (parent.width - 22px) / 2;
                            y: (parent.height - 16px) / 2;
                            width: 22px;
                            height: 16px;
                            viewbox-width: 22;
                            viewbox-height: 16;
                            commands: "M 17 0 L 22 3 L 17 6 Z M 17 10 L 22 13 L 17 16 Z";
                            fill: root.shuffle ? Theme.accent : Theme.text-dim;
                        }
                    }
                }

                // Anterior
                NeuButton {
                    size: 56px;
                    clicked => {
                        root.previous-track();
                    }
                    Path {
                        x: (parent.width - 18px) / 2;
                        y: (parent.height - 18px) / 2;
                        width: 18px;
                        height: 18px;
                        viewbox-width: 18;
                        viewbox-height: 18;
                        commands: "M 0 0 L 4 0 L 4 18 L 0 18 Z M 18 0 L 6 9 L 18 18 Z";
                        fill: Theme.text;
                    }
                }

                // Reproducir / pausar
                NeuButton {
                    size: 74px;
                    clicked => {
                        root.toggle-play();
                    }
                    if !root.playing: Path {
                        x: (parent.width - 20px) / 2 + 2px;
                        y: (parent.height - 24px) / 2;
                        width: 20px;
                        height: 24px;
                        viewbox-width: 20;
                        viewbox-height: 24;
                        commands: "M 0 0 L 20 12 L 0 24 Z";
                        fill: Theme.accent;
                    }
                    if root.playing: Path {
                        x: (parent.width - 20px) / 2;
                        y: (parent.height - 24px) / 2;
                        width: 20px;
                        height: 24px;
                        viewbox-width: 20;
                        viewbox-height: 24;
                        commands: "M 0 0 L 7 0 L 7 24 L 0 24 Z M 13 0 L 20 0 L 20 24 L 13 24 Z";
                        fill: Theme.accent;
                    }
                }

                // Siguiente
                NeuButton {
                    size: 56px;
                    clicked => {
                        root.next-track();
                    }
                    Path {
                        x: (parent.width - 18px) / 2;
                        y: (parent.height - 18px) / 2;
                        width: 18px;
                        height: 18px;
                        viewbox-width: 18;
                        viewbox-height: 18;
                        commands: "M 0 0 L 12 9 L 0 18 Z M 14 0 L 18 0 L 18 18 L 14 18 Z";
                        fill: Theme.text;
                    }
                }

                // Repetir (desactivado / toda la lista / una canción)
                NeuButton {
                    size: 46px;
                    active: root.repeat-mode != 0;
                    clicked => {
                        root.cycle-repeat();
                    }
                    Rectangle {
                        Path {
                            x: (parent.width - 22px) / 2;
                            y: (parent.height - 18px) / 2;
                            width: 22px;
                            height: 18px;
                            viewbox-width: 22;
                            viewbox-height: 18;
                            commands: "M 3 9 L 3 8 C 3 5 5 3 8 3 L 16 3 M 19 9 L 19 10 C 19 13 17 15 14 15 L 6 15";
                            stroke: root.repeat-mode != 0 ? Theme.accent : Theme.text-dim;
                            stroke-width: 2px;
                        }
                        Path {
                            x: (parent.width - 22px) / 2;
                            y: (parent.height - 18px) / 2;
                            width: 22px;
                            height: 18px;
                            viewbox-width: 22;
                            viewbox-height: 18;
                            commands: "M 15 0 L 20 3 L 15 6 Z M 7 12 L 2 15 L 7 18 Z";
                            fill: root.repeat-mode != 0 ? Theme.accent : Theme.text-dim;
                        }
                        if root.repeat-mode == 2: Text {
                            text: "1";
                            color: Theme.accent;
                            font-size: 9px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Volumen
            HorizontalLayout {
                spacing: 12px;
                padding-top: 6px;
                Path {
                    width: 18px;
                    height: 16px;
                    y: 4px;
                    viewbox-width: 18;
                    viewbox-height: 16;
                    commands: "M 0 5 L 4 5 L 9 0 L 9 16 L 4 11 L 0 11 Z M 12 4 C 14.5 6.5 14.5 9.5 12 12";
                    fill: Theme.text-dim;
                    stroke: Theme.text-dim;
                    stroke-width: 1.5px;
                }
                NeuSlider {
                    horizontal-stretch: 1;
                    value <=> root.volume;
                    moved(v) => {
                        root.set-volume(v);
                    }
                }
            }

            // Normalización de volumen y crossfade.
            VerticalLayout {
                spacing: 10px;
                padding-top: 4px;
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        horizontal-stretch: 1;
                        text: "Normalizar volumen";
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    NeuSwitch {
                        on: root.normalize;
                        toggled => {
                            root.normalize = !root.normalize;
                            root.normalize-changed(root.normalize);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        horizontal-stretch: 1;
                        text: "Crossfade";
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    MiniButton {
                        label: "−";
                        clicked => {
                            if (root.crossfade-secs > 0) {
                                root.crossfade-secs = root.crossfade-secs - 1;
                                root.crossfade-changed(root.crossfade-secs);
                            }
                        }
                    }
                    Text {
                        width: 48px;
                        text: root.crossfade-secs == 0 ? "No" : "" + root.crossfade-secs + " s";
                        color: root.crossfade-secs == 0 ? Theme.text-dim : Theme.accent;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    MiniButton {
                        label: "+";
                        clicked => {
                            if (root.crossfade-secs < 12) {
                                root.crossfade-secs = root.crossfade-secs + 1;
                                root.crossfade-changed(root.crossfade-secs);
                            }
                        }
                    }
                }
            }
        }

        // ---------- Biblioteca ----------
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 18px;

            HorizontalLayout {
                spacing: 18px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "Acustia Player";
                        color: Theme.text;
                        font-size: 26px;
                        font-weight: 800;
                    }
                    Text {
                        text: root.folder-name;
                        color: Theme.text-dim;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                NeuPill {
                    label: "Añadir carpeta";
                    clicked => {
                        root.pick-folder();
                    }
                }

                // Tema claro / oscuro: muestra una luna en claro y un sol en oscuro.
                NeuButton {
                    size: 44px;
                    clicked => {
                        Theme.dark = !Theme.dark;
                        root.theme-changed(Theme.dark);
                    }
                    if !Theme.dark: Path {
                        x: (parent.width - 18px) / 2;
                        y: (parent.height - 18px) / 2;
                        width: 18px;
                        height: 18px;
                        viewbox-width: 18;
                        viewbox-height: 18;
                        commands: "M 9 1 A 8 8 0 0 0 9 17 A 10 10 0 0 1 9 1 Z";
                        fill: Theme.text;
                    }
                    if Theme.dark: Path {
                        x: (parent.width - 18px) / 2;
                        y: (parent.height - 18px) / 2;
                        width: 18px;
                        height: 18px;
                        viewbox-width: 18;
                        viewbox-height: 18;
                        commands: "M 9 5.5 A 3.5 3.5 0 1 1 9 12.5 A 3.5 3.5 0 1 1 9 5.5 Z M 9 0.5 L 9 2.5 M 9 15.5 L 9 17.5 M 0.5 9 L 2.5 9 M 15.5 9 L 17.5 9 M 3 3 L 4.4 4.4 M 13.6 13.6 L 15 15 M 15 3 L 13.6 4.4 M 4.4 13.6 L 3 15";
                        fill: Theme.text;
                        stroke: Theme.text;
                        stroke-width: 1.5px;
                    }
                }

                // Modo gadget.
                NeuButton {
                    size: 44px;
                    clicked => {
                        root.widget-toggle();
                    }
                    Path {
                        x: (parent.width - 18px) / 2;
                        y: (parent.height - 18px) / 2;
                        width: 18px;
                        height: 18px;
                        viewbox-width: 18;
                        viewbox-height: 18;
                        commands: "M 1 4 L 17 4 L 17 14 L 1 14 Z M 1 8 L 17 8";
                        stroke: Theme.text;
                        stroke-width: 1.8px;
                    }
                }

                // Minimizar a la bandeja del sistema.
                NeuButton {
                    size: 44px;
                    clicked => {
                        root.minimize-to-tray();
                    }
                    Path {
                        x: (parent.width - 18px) / 2;
                        y: (parent.height - 18px) / 2;
                        width: 18px;
                        height: 18px;
                        viewbox-width: 18;
                        viewbox-height: 18;
                        commands: "M 3 3 L 9 9 L 15 3 M 2 15 L 16 15";
                        stroke: Theme.text;
                        stroke-width: 2px;
                    }
                }
            }

            // Carpetas: una pestaña por carpeta, la reproducción se alterna entre ellas.
            if root.folders.length > 0: Flickable {
                height: 50px;
                content-width: root.folders.length * 176px;
                for folder[i] in root.folders: FolderChip {
                    x: i * 176px;
                    y: 3px;
                    item: folder;
                    selected: i == root.selected-folder;
                    activated => {
                        root.select-folder(i);
                    }
                    removed => {
                        root.remove-folder(i);
                    }
                }
            }

            // Modo de la carpeta seleccionada: música (CD) o podcast (cassette).
            if root.folders.length > 0: NeuCheck {
                label: "Modo podcast (esta carpeta)";
                checked: root.podcast-mode;
                toggled => {
                    root.podcast-changed(!root.podcast-mode);
                }
            }

            // Búsqueda y accesos: solo favoritos, historial, audio (ecualizador).
            HorizontalLayout {
                spacing: 10px;
                // Búsqueda.
                NeuInset {
                    horizontal-stretch: 1;
                    height: 42px;
                    radius: 21px;
                    Path {
                        x: 16px;
                        y: (parent.height - 16px) / 2;
                        width: 16px;
                        height: 16px;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        commands: "M 6.5 1.5 A 5 5 0 1 1 6.5 11.5 A 5 5 0 1 1 6.5 1.5 Z M 10.5 10.5 L 15 15";
                        stroke: Theme.text-dim;
                        stroke-width: 1.8px;
                    }
                    if root.search-text == "": Text {
                        x: 44px;
                        width: parent.width - 90px;
                        text: "Buscar canciones…";
                        color: Theme.text-dim;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                    search-input := TextInput {
                        x: 44px;
                        y: (parent.height - self.preferred-height) / 2;
                        width: parent.width - 90px;
                        text <=> root.search-text;
                        color: Theme.text;
                        font-size: 14px;
                        single-line: true;
                        edited => {
                            root.search-changed(self.text);
                        }
                    }
                    if root.search-text != "": Rectangle {
                        x: parent.width - 38px;
                        y: (parent.height - 28px) / 2;
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: clear-ta.has-hover ? Theme.row-current : transparent;
                        Path {
                            x: (parent.width - 10px) / 2;
                            y: (parent.height - 10px) / 2;
                            width: 10px;
                            height: 10px;
                            viewbox-width: 10;
                            viewbox-height: 10;
                            commands: "M 1 1 L 9 9 M 9 1 L 1 9";
                            stroke: Theme.text-dim;
                            stroke-width: 1.5px;
                        }
                        clear-ta := TouchArea {
                            clicked => {
                                root.search-text = "";
                                root.search-changed("");
                            }
                        }
                    }
                }

                // Ver solo favoritos.
                NeuButton {
                    size: 42px;
                    active: root.favorites-only;
                    clicked => {
                        root.favorites-only = !root.favorites-only;
                        root.favorites-only-changed(root.favorites-only);
                    }
                    Path {
                        x: (parent.width - 16px) / 2;
                        y: (parent.height - 16px) / 2;
                        width: 16px;
                        height: 16px;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        commands: "M 8 0.8 L 10.1 5.5 L 15.2 6.1 L 11.4 9.6 L 12.5 14.7 L 8 12.1 L 3.5 14.7 L 4.6 9.6 L 0.8 6.1 L 5.9 5.5 Z";
                        fill: root.favorites-only ? Theme.accent : transparent;
                        stroke: root.favorites-only ? Theme.accent : Theme.text-dim;
                        stroke-width: 1.5px;
                    }
                }

                // Historial de reproducción.
                NeuButton {
                    size: 42px;
                    active: root.history-open;
                    clicked => {
                        root.history-open = true;
                        root.history-opened();
                    }
                    Path {
                        x: (parent.width - 16px) / 2;
                        y: (parent.height - 16px) / 2;
                        width: 16px;
                        height: 16px;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        commands: "M 8 1 A 7 7 0 1 1 8 15 A 7 7 0 1 1 8 1 Z M 8 4 L 8 8 L 11 10";
                        stroke: Theme.text-dim;
                        stroke-width: 1.6px;
                    }
                }

                // Ecualizador y normalización.
                NeuButton {
                    size: 42px;
                    active: root.audio-open || root.eq-enabled;
                    clicked => {
                        root.audio-open = true;
                    }
                    Path {
                        x: (parent.width - 16px) / 2;
                        y: (parent.height - 16px) / 2;
                        width: 16px;
                        height: 16px;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        commands: "M 3 1 L 3 15 M 8 1 L 8 15 M 13 1 L 13 15 M 1 10 L 5 10 M 6 5 L 10 5 M 11 11 L 15 11";
                        stroke: root.eq-enabled ? Theme.accent : Theme.text-dim;
                        stroke-width: 1.6px;
                    }
                }

                // Apariencia: Ambient Light, colores del tema y atajos.
                NeuButton {
                    size: 42px;
                    active: root.appearance-open;
                    clicked => {
                        root.appearance-open = true;
                    }
                    Path {
                        x: (parent.width - 16px) / 2;
                        y: (parent.height - 16px) / 2;
                        width: 16px;
                        height: 16px;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        commands: "M 8 1 A 7 7 0 1 1 8 15 A 7 7 0 1 1 8 1 Z";
                        stroke: Theme.text-dim;
                        stroke-width: 1.6px;
                    }
                    Path {
                        x: (parent.width - 16px) / 2;
                        y: (parent.height - 16px) / 2;
                        width: 16px;
                        height: 16px;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        commands: "M 8 5 A 3 3 0 1 1 8 11 A 3 3 0 1 1 8 5 Z";
                        fill: Theme.accent;
                    }
                }

                // Estadísticas de escucha.
                NeuButton {
                    size: 42px;
                    active: root.stats-open;
                    clicked => {
                        root.stats-open = true;
                        root.stats-opened();
                    }
                    Path {
                        x: (parent.width - 16px) / 2;
                        y: (parent.height - 16px) / 2;
                        width: 16px;
                        height: 16px;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        commands: "M 2 15 L 2 8 M 7 15 L 7 2 M 12 15 L 12 6";
                        stroke: Theme.text-dim;
                        stroke-width: 2.4px;
                    }
                }

                // Ajustes (widget, inicio con el equipo).
                NeuButton {
                    size: 42px;
                    active: root.settings-open;
                    clicked => {
                        root.settings-open = true;
                    }
                    Path {
                        x: (parent.width - 16px) / 2;
                        y: (parent.height - 16px) / 2;
                        width: 16px;
                        height: 16px;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        commands: "M 8 5.5 A 2.5 2.5 0 1 1 8 10.5 A 2.5 2.5 0 1 1 8 5.5 Z M 8 0.8 L 8 3 M 8 13 L 8 15.2 M 0.8 8 L 3 8 M 13 8 L 15.2 8 M 2.9 2.9 L 4.4 4.4 M 11.6 11.6 L 13.1 13.1 M 13.1 2.9 L 11.6 4.4 M 4.4 11.6 L 2.9 13.1";
                        stroke: Theme.text-dim;
                        stroke-width: 1.6px;
                    }
                }
            }

            NeuInset {
                vertical-stretch: 1;
                radius: 22px;

                if root.tracks.length == 0: Text {
                    text: root.empty-text;
                    color: Theme.text-dim;
                    font-size: 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if root.tracks.length > 0: ListView {
                    x: 10px;
                    y: 10px;
                    width: parent.width - 20px;
                    height: parent.height - 20px;
                    for track in root.tracks: TrackRow {
                        item: track;
                        activated => {
                            root.play-index(track.index);
                        }
                        edit => {
                            root.edit-track(track.index);
                        }
                        toggle-favorite => {
                            root.toggle-favorite(track.index);
                        }
                    }
                }
            }

            Rectangle {
                height: 18px;
                Text {
                    text: root.show-debug ? root.debug-text : root.status-message;
                    color: Theme.text-dim;
                    font-size: 12px;
                    overflow: elide;
                }
                TouchArea {
                    clicked => {
                        root.show-debug = !root.show-debug;
                    }
                }
            }
        }
    }

    // ---------- Gadget de escritorio ----------
    // Tarjeta compacta (340×150) sin marco, al estilo de los mini reproductores de escritorio:
    // carátula, título, barra de progreso, aleatorio / anterior / play / siguiente / repetir y
    // un selector con las carpetas YA cargadas. Se arrastra desde cualquier parte libre.
    if root.widget-mode: Rectangle {
        width: root.width;
        height: root.height;
        background: Theme.bg;
        border-width: 1px;
        border-color: Theme.shadow;

        drag := TouchArea {
            moved => {
                root.widget-drag(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }

        // Carátula.
        Rectangle {
            x: 12px;
            y: 10px;
            width: 44px;
            height: 44px;
            border-radius: 7px;
            clip: true;
            background: Theme.inset-top;
            if root.has-cover: Image {
                source: root.current-cover;
                image-fit: ImageFit.cover;
                width: parent.width;
                height: parent.height;
            }
            if !root.has-cover: Text {
                text: root.now-podcast ? "◉" : "♪";
                color: Theme.text-dim;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Título y artista.
        VerticalLayout {
            x: 66px;
            y: 12px;
            width: 340px - 66px - 12px - 84px;
            height: 40px;
            spacing: 2px;
            Text {
                text: root.current-title;
                color: Theme.text;
                font-size: 14px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: root.current-artist;
                color: Theme.text-dim;
                font-size: 11px;
                overflow: elide;
            }
        }

        // Botones de arriba a la derecha: carpetas, ventana completa, ocultar.
        HorizontalLayout {
            x: 340px - 12px - 78px;
            y: 8px;
            width: 78px;
            height: 26px;
            spacing: 0px;
            GadgetButton {
                size: 26px;
                clicked => {
                    root.gadget-folders-open = !root.gadget-folders-open;
                }
                Path {
                    x: (parent.width - 12px) / 2;
                    y: (parent.height - 12px) / 2;
                    width: 12px;
                    height: 12px;
                    viewbox-width: 12;
                    viewbox-height: 12;
                    commands: "M 1 2 L 4.5 2 L 6 4 L 11 4 L 11 10 L 1 10 Z";
                    stroke: root.gadget-folders-open ? Theme.accent : Theme.text-dim;
                    stroke-width: 1.4px;
                }
            }
            GadgetButton {
                size: 26px;
                clicked => {
                    root.widget-toggle();
                }
                Path {
                    x: (parent.width - 11px) / 2;
                    y: (parent.height - 11px) / 2;
                    width: 11px;
                    height: 11px;
                    viewbox-width: 11;
                    viewbox-height: 11;
                    commands: "M 1 4 L 1 1 L 4 1 M 7 1 L 10 1 L 10 4 M 10 7 L 10 10 L 7 10 M 4 10 L 1 10 L 1 7";
                    stroke: Theme.text-dim;
                    stroke-width: 1.4px;
                }
            }
            GadgetButton {
                size: 26px;
                clicked => {
                    root.minimize-to-tray();
                }
                Path {
                    x: (parent.width - 10px) / 2;
                    y: (parent.height - 10px) / 2;
                    width: 10px;
                    height: 10px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    commands: "M 1 1 L 9 9 M 9 1 L 1 9";
                    stroke: Theme.text-dim;
                    stroke-width: 1.4px;
                }
            }
        }

        // Progreso y tiempos.
        GadgetSlider {
            x: 12px;
            y: 60px;
            width: 340px - 24px;
            value <=> root.progress;
            dragging-changed(v) => {
                root.dragging = v;
            }
            released(v) => {
                root.seek(v);
            }
        }
        Text {
            x: 12px;
            y: 76px;
            text: root.position-text;
            color: Theme.text-dim;
            font-size: 10px;
        }
        Text {
            x: 340px - 12px - 60px;
            y: 76px;
            width: 60px;
            text: root.duration-text;
            color: Theme.text-dim;
            font-size: 10px;
            horizontal-alignment: right;
        }

        // Controles.
        // Fila centrada de controles (posiciones fijas: 6 botones con 14 px entre ellos).
        Rectangle {
            x: 0px;
            y: 0px;
            width: 340px;
            height: 150px;
            // Favorita (corazón).
            GadgetButton {
                size: 28px;
                x: 35px;
                y: 100px;
                clicked => {
                    root.toggle-current-favorite();
                }
                Path {
                    x: (parent.width - 16px) / 2;
                    y: (parent.height - 15px) / 2;
                    width: 16px;
                    height: 15px;
                    viewbox-width: 16;
                    viewbox-height: 15;
                    commands: "M 8 14 C 2 9.8 0.8 7 0.8 4.8 C 0.8 2.6 2.4 1.2 4.3 1.2 C 5.8 1.2 7.2 2 8 3.4 C 8.8 2 10.2 1.2 11.7 1.2 C 13.6 1.2 15.2 2.6 15.2 4.8 C 15.2 7 14 9.8 8 14 Z";
                    fill: root.current-favorite ? Theme.accent : transparent;
                    stroke: root.current-favorite ? Theme.accent : Theme.text-dim;
                    stroke-width: 1.5px;
                }
            }
            GadgetButton {
                size: 30px;
                x: 77px;
                y: 99px;
                clicked => {
                    root.toggle-shuffle();
                }
                Path {
                    x: (parent.width - 18px) / 2;
                    y: (parent.height - 13px) / 2;
                    width: 18px;
                    height: 13px;
                    viewbox-width: 22;
                    viewbox-height: 16;
                    commands: "M 0 3 L 5 3 C 10 3 11 13 16 13 L 19 13 M 0 13 L 5 13 C 10 13 11 3 16 3 L 19 3 M 17 0 L 22 3 L 17 6 Z M 17 10 L 22 13 L 17 16 Z";
                    stroke: root.shuffle ? Theme.accent : Theme.text-dim;
                    fill: root.shuffle ? Theme.accent : Theme.text-dim;
                    stroke-width: 2px;
                }
            }
            GadgetButton {
                size: 34px;
                x: 121px;
                y: 98px;
                clicked => {
                    root.previous-track();
                }
                Path {
                    x: (parent.width - 14px) / 2;
                    y: (parent.height - 14px) / 2;
                    width: 14px;
                    height: 14px;
                    viewbox-width: 18;
                    viewbox-height: 18;
                    commands: "M 0 0 L 4 0 L 4 18 L 0 18 Z M 18 0 L 6 9 L 18 18 Z";
                    fill: Theme.text;
                }
            }
            // Reproducir / pausar: círculo lleno como en la referencia.
            Rectangle {
                x: 169px;
                y: 93px;
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: Theme.text;
                if !root.playing: Path {
                    x: (parent.width - 14px) / 2 + 1px;
                    y: (parent.height - 17px) / 2;
                    width: 14px;
                    height: 17px;
                    viewbox-width: 20;
                    viewbox-height: 24;
                    commands: "M 0 0 L 20 12 L 0 24 Z";
                    fill: Theme.bg;
                }
                if root.playing: Path {
                    x: (parent.width - 14px) / 2;
                    y: (parent.height - 17px) / 2;
                    width: 14px;
                    height: 17px;
                    viewbox-width: 20;
                    viewbox-height: 24;
                    commands: "M 0 0 L 7 0 L 7 24 L 0 24 Z M 13 0 L 20 0 L 20 24 L 13 24 Z";
                    fill: Theme.bg;
                }
                TouchArea {
                    clicked => {
                        root.toggle-play();
                    }
                }
            }
            GadgetButton {
                size: 34px;
                x: 227px;
                y: 98px;
                clicked => {
                    root.next-track();
                }
                Path {
                    x: (parent.width - 14px) / 2;
                    y: (parent.height - 14px) / 2;
                    width: 14px;
                    height: 14px;
                    viewbox-width: 18;
                    viewbox-height: 18;
                    commands: "M 0 0 L 12 9 L 0 18 Z M 14 0 L 18 0 L 18 18 L 14 18 Z";
                    fill: Theme.text;
                }
            }
            GadgetButton {
                size: 30px;
                x: 275px;
                y: 99px;
                clicked => {
                    root.cycle-repeat();
                }
                Path {
                    x: (parent.width - 17px) / 2;
                    y: (parent.height - 14px) / 2;
                    width: 17px;
                    height: 14px;
                    viewbox-width: 22;
                    viewbox-height: 18;
                    commands: "M 3 9 L 3 8 C 3 5 5 3 8 3 L 16 3 M 19 9 L 19 10 C 19 13 17 15 14 15 L 6 15 M 15 0 L 20 3 L 15 6 Z M 7 12 L 2 15 L 7 18 Z";
                    stroke: root.repeat-mode != 0 ? Theme.accent : Theme.text-dim;
                    fill: root.repeat-mode != 0 ? Theme.accent : Theme.text-dim;
                    stroke-width: 2px;
                }
                if root.repeat-mode == 2: Text {
                    text: "1";
                    color: Theme.accent;
                    font-size: 8px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Selector de carpeta: solo las ya cargadas (elegir una no lee nada del disco).
        if root.gadget-folders-open: Rectangle {
            width: parent.width;
            height: parent.height;
            background: Theme.bg;
            TouchArea {}
            Text {
                x: 14px;
                y: 10px;
                text: "Carpetas cargadas";
                color: Theme.text-dim;
                font-size: 11px;
                font-weight: 700;
            }
            GadgetButton {
                x: parent.width - 12px - 26px;
                y: 6px;
                size: 26px;
                clicked => {
                    root.gadget-folders-open = false;
                }
                Path {
                    x: (parent.width - 10px) / 2;
                    y: (parent.height - 10px) / 2;
                    width: 10px;
                    height: 10px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    commands: "M 1 1 L 9 9 M 9 1 L 1 9";
                    stroke: Theme.text-dim;
                    stroke-width: 1.4px;
                }
            }
            if root.loaded-folder-count == 0: Text {
                x: 14px;
                y: 40px;
                width: parent.width - 28px;
                text: "Aún no hay carpetas cargadas. Ábrelas una vez desde la ventana completa.";
                color: Theme.text-dim;
                font-size: 12px;
                wrap: word-wrap;
            }
            Flickable {
                x: 8px;
                y: 36px;
                width: parent.width - 16px;
                height: parent.height - 44px;
                VerticalLayout {
                    width: parent.width;
                    for f[i] in root.folders: Rectangle {
                        height: (f.loaded && !f.missing) ? 30px : 0px;
                        visible: f.loaded && !f.missing;
                        border-radius: 8px;
                        background: pick-ta.has-hover ? Theme.row-current : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            Text {
                                text: f.playing ? "♪" : (f.podcast ? "◉" : " ");
                                color: Theme.accent;
                                font-size: 12px;
                                width: 14px;
                                vertical-alignment: center;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: f.name;
                                color: f.playing ? Theme.accent : Theme.text;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: "" + f.count;
                                color: Theme.text-dim;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                        pick-ta := TouchArea {
                            clicked => {
                                root.gadget-pick-folder(i);
                            }
                        }
                    }
                }
            }
        }
    }

    // ---------- Ajustes ----------
    if root.settings-open: Rectangle {
        width: root.width;
        height: root.height;
        background: #00000066;
        TouchArea {
            clicked => {
                root.settings-open = false;
            }
        }

        NeuRaised {
            width: min(520px, parent.width - 48px);
            height: min(420px, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            radius: 24px;
            depth: 8px;
            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: "Ajustes";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 700;
                    }
                    TextButton {
                        width: 70px;
                        label: "Cerrar";
                        clicked => {
                            root.settings-open = false;
                        }
                    }
                }
                Text {
                    text: "Modo gadget";
                    color: Theme.accent;
                    font-size: 12px;
                    font-weight: 700;
                }
                NeuCheck {
                    label: "Abrir siempre en modo gadget";
                    checked: root.widget-on-start;
                    toggled => {
                        root.widget-on-start-changed(!root.widget-on-start);
                    }
                }
                NeuCheck {
                    label: "Gadget siempre encima de otras ventanas";
                    checked: root.widget-on-top;
                    toggled => {
                        root.widget-on-top-changed(!root.widget-on-top);
                    }
                }
                Text {
                    text: "El gadget es una tarjeta mínima (carátula, progreso, controles y selector de carpetas ya cargadas). Se queda donde lo sueltes y recuerda su posición; arrástralo desde cualquier parte libre.";
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Inicio";
                    color: Theme.accent;
                    font-size: 12px;
                    font-weight: 700;
                }
                NeuCheck {
                    label: "Iniciar Acustia al arrancar el equipo";
                    checked: root.autostart;
                    toggled => {
                        root.autostart-changed(!root.autostart);
                    }
                }
                if root.autostart-status != "": Text {
                    text: root.autostart-status;
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle {
                    vertical-stretch: 1;
                }
                NeuPill {
                    label: "Pasar a modo gadget ahora";
                    clicked => {
                        root.settings-open = false;
                        root.widget-toggle();
                    }
                }
            }
        }
    }

    // ---------- Estadísticas ----------
    if root.stats-open: Rectangle {
        width: root.width;
        height: root.height;
        background: #00000066;
        TouchArea {
            clicked => {
                root.stats-open = false;
            }
        }

        NeuRaised {
            width: min(620px, parent.width - 48px);
            height: min(640px, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            radius: 24px;
            depth: 8px;
            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        text: "Estadísticas de escucha";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 700;
                    }
                    TextButton {
                        width: 90px;
                        label: "Reiniciar";
                        clicked => {
                            root.stats-reset();
                        }
                    }
                    TextButton {
                        width: 60px;
                        label: "Cerrar";
                        clicked => {
                            root.stats-open = false;
                        }
                    }
                }
                NeuInset {
                    vertical-stretch: 1;
                    radius: 18px;
                    Flickable {
                        x: 12px;
                        y: 12px;
                        width: parent.width - 24px;
                        height: parent.height - 24px;
                        VerticalLayout {
                            width: parent.width;
                            spacing: 6px;
                            for row in root.stats-summary: HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: row.label;
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.value;
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 700;
                                    horizontal-alignment: right;
                                }
                            }

                            Text {
                                text: root.stats-bars-caption;
                                color: Theme.accent;
                                font-size: 12px;
                                font-weight: 700;
                            }
                            Rectangle {
                                height: 70px;
                                HorizontalLayout {
                                    spacing: 3px;
                                    for v in root.stats-bars: Rectangle {
                                        Rectangle {
                                            y: parent.height - self.height;
                                            height: max(2px, parent.height * v);
                                            border-radius: 2px;
                                            background: Theme.accent;
                                            opacity: v > 0 ? 1.0 : 0.25;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: "Canciones más escuchadas";
                                color: Theme.accent;
                                font-size: 12px;
                                font-weight: 700;
                            }
                            if root.stats-top-tracks.length == 0: Text {
                                text: "Aún no hay datos";
                                color: Theme.text-dim;
                                font-size: 12px;
                            }
                            for row[i] in root.stats-top-tracks: HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: "" + (i + 1) + ". " + row.label;
                                    color: Theme.text;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.value;
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    horizontal-alignment: right;
                                }
                            }

                            Text {
                                text: "Artistas más escuchados";
                                color: Theme.accent;
                                font-size: 12px;
                                font-weight: 700;
                            }
                            if root.stats-top-artists.length == 0: Text {
                                text: "Aún no hay datos";
                                color: Theme.text-dim;
                                font-size: 12px;
                            }
                            for row[i] in root.stats-top-artists: HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: "" + (i + 1) + ". " + row.label;
                                    color: Theme.text;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.value;
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---------- Editar metadatos de una canción ----------
    if root.editing: Rectangle {
        width: root.width;
        height: root.height;
        background: #00000066;
        // Absorbe los clics para que no lleguen a la lista de debajo.
        TouchArea {}

        NeuRaised {
            width: min(540px, parent.width - 48px);
            height: min(470px, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            radius: 24px;
            depth: 8px;

            VerticalLayout {
                padding: 24px;
                spacing: 10px;
                Text {
                    text: "Editar metadatos";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: root.edit-file;
                    color: Theme.text-dim;
                    font-size: 12px;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 18px;
                    // Carátula
                    VerticalLayout {
                        width: 132px;
                        spacing: 6px;
                        alignment: start;
                        NeuInset {
                            width: 132px;
                            height: 132px;
                            radius: 16px;
                            Rectangle {
                                x: 4px;
                                y: 4px;
                                width: parent.width - 8px;
                                height: parent.height - 8px;
                                border-radius: 12px;
                                clip: true;
                                if root.edit-has-cover: Image {
                                    source: root.edit-cover;
                                    image-fit: ImageFit.cover;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                if !root.edit-has-cover: Text {
                                    text: "♪";
                                    color: Theme.text-dim;
                                    font-size: 48px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        TextButton {
                            label: "Cambiar carátula…";
                            clicked => {
                                if (!root.edit-busy) {
                                    root.edit-pick-cover();
                                }
                            }
                        }
                        if root.edit-has-cover: TextButton {
                            label: "Quitar carátula";
                            clicked => {
                                if (!root.edit-busy) {
                                    root.edit-remove-cover();
                                }
                            }
                        }
                    }
                    // Campos
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        NeuField {
                            label: "Título";
                            value <=> root.edit-title;
                            disabled: root.edit-busy;
                            accepted => {
                                root.edit-save();
                            }
                            escaped => {
                                root.editing = false;
                                root.edit-cancel();
                            }
                        }
                        NeuField {
                            label: "Artista";
                            value <=> root.edit-artist;
                            disabled: root.edit-busy;
                            accepted => {
                                root.edit-save();
                            }
                            escaped => {
                                root.editing = false;
                                root.edit-cancel();
                            }
                        }
                        NeuField {
                            label: "Álbum";
                            value <=> root.edit-album;
                            disabled: root.edit-busy;
                            accepted => {
                                root.edit-save();
                            }
                            escaped => {
                                root.editing = false;
                                root.edit-cancel();
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            NeuField {
                                horizontal-stretch: 1;
                                label: "Género";
                                value <=> root.edit-genre;
                                disabled: root.edit-busy;
                                accepted => {
                                    root.edit-save();
                                }
                                escaped => {
                                    root.editing = false;
                                    root.edit-cancel();
                                }
                            }
                            NeuField {
                                width: 90px;
                                label: "Año";
                                value <=> root.edit-year;
                                disabled: root.edit-busy;
                                accepted => {
                                    root.edit-save();
                                }
                                escaped => {
                                    root.editing = false;
                                    root.edit-cancel();
                                }
                            }
                        }
                    }
                }
                Text {
                    text: root.edit-error;
                    color: #d9534f;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle {
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    if root.edit-error != "": NeuPill {
                        label: "Solo en la app";
                        min-width: 120px;
                        clicked => {
                            root.edit-save-local();
                        }
                    }
                    NeuPill {
                        label: "Cancelar";
                        min-width: 110px;
                        clicked => {
                            root.editing = false;
                            root.edit-cancel();
                        }
                    }
                    NeuPill {
                        label: root.edit-busy ? "Espere…" : "Guardar";
                        min-width: 110px;
                        clicked => {
                            root.edit-save();
                        }
                    }
                }
            }
        }
    }

    // ---------- Audio: ecualizador, presets y ReplayGain ----------
    if root.audio-open: Rectangle {
        width: root.width;
        height: root.height;
        background: #00000066;
        TouchArea {
            clicked => {
                root.audio-open = false;
            }
        }

        NeuRaised {
            width: min(720px, parent.width - 48px);
            height: min(560px, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            radius: 24px;
            depth: 8px;
            // Los clics dentro del panel no lo cierran.
            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: "Ecualizador";
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Preset: " + root.eq-preset-label;
                            color: Theme.text-dim;
                            font-size: 12px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        NeuSwitch {
                            on: root.eq-enabled;
                            toggled => {
                                root.eq-enabled = !root.eq-enabled;
                                root.eq-toggled(root.eq-enabled);
                            }
                        }
                    }
                }

                // Presets.
                Flickable {
                    height: 46px;
                    content-width: root.eq-preset-names.length * 148px;
                    for name[i] in root.eq-preset-names: PresetChip {
                        x: i * 148px;
                        y: 4px;
                        label: name;
                        selected: i == root.eq-preset;
                        activated => {
                            root.eq-preset-selected(i);
                        }
                    }
                }

                // Bandas.
                HorizontalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 10px;
                    for g[i] in root.eq-gains: EqBand {
                        label: root.eq-band-names[i];
                        gain-text: root.eq-gain-texts[i];
                        gain: g;
                        active: root.eq-enabled;
                        band-moved(v) => {
                            root.eq-band-changed(i, v);
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    TextButton {
                        width: 150px;
                        label: "Restablecer (plano)";
                        clicked => {
                            root.eq-reset();
                        }
                    }
                }

                // ReplayGain.
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: "ReplayGain: usar ganancia de álbum";
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Con «Normalizar volumen» activado se usan las etiquetas ReplayGain del archivo (pista o álbum); sin etiquetas se mide la sonoridad.";
                            color: Theme.text-dim;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        NeuSwitch {
                            on: root.replaygain-album;
                            toggled => {
                                root.replaygain-album = !root.replaygain-album;
                                root.replaygain-album-changed(root.replaygain-album);
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    NeuPill {
                        label: "Cerrar";
                        min-width: 110px;
                        clicked => {
                            root.audio-open = false;
                        }
                    }
                }
            }
        }
    }

    // ---------- Apariencia: Ambient Light, temas y atajos ----------
    if root.appearance-open: Rectangle {
        width: root.width;
        height: root.height;
        background: #00000066;
        TouchArea {
            clicked => {
                root.appearance-open = false;
            }
        }

        NeuRaised {
            width: min(600px, parent.width - 48px);
            height: min(620px, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            radius: 24px;
            depth: 8px;
            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: "Apariencia";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                }

                // Modo base.
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: "Modo";
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    PresetChip {
                        label: "Claro";
                        selected: !Theme.dark;
                        activated => {
                            Theme.dark = false;
                            root.theme-changed(false);
                        }
                    }
                    PresetChip {
                        label: "Oscuro";
                        selected: Theme.dark;
                        activated => {
                            Theme.dark = true;
                            root.theme-changed(true);
                        }
                    }
                }

                // Ambient Light.
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: "Ambient Light (colores de la carátula)";
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 600;
                        }
                        Text {
                            text: "El acento, el fondo y un resplandor tras el CD toman el color dominante de la canción que suena. Si lo desactivas, se usan tus colores.";
                            color: Theme.text-dim;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        NeuSwitch {
                            on: root.ambient;
                            toggled => {
                                root.ambient = !root.ambient;
                                root.ambient-changed(root.ambient);
                            }
                        }
                    }
                }

                // Colores propios (sin efecto mientras Ambient Light usa una carátula).
                Rectangle {
                    opacity: root.ambient-active ? 0.45 : 1.0;
                    VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            Text {
                                text: root.ambient-active ? "Tus colores (Ambient Light está usando la carátula)" : "Tus colores";
                                color: Theme.text;
                                font-size: 13px;
                                font-weight: 600;
                                horizontal-stretch: 1;
                            }
                            TextButton {
                                width: 90px;
                                label: "Restablecer";
                                clicked => {
                                    root.theme-reset();
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            for c[i] in root.theme-preset-colors: Swatch {
                                swatch: c;
                                selected: i == root.theme-preset;
                                activated => {
                                    root.theme-preset-selected(i);
                                }
                            }
                        }
                        Text {
                            text: root.theme-preset >= 0 ? "Tema: " + root.theme-preset-names[root.theme-preset] : "Tema: personalizado";
                            color: Theme.text-dim;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Color de acento";
                                color: Theme.text-dim;
                                font-size: 12px;
                                width: 120px;
                                vertical-alignment: center;
                            }
                            NeuSlider {
                                horizontal-stretch: 1;
                                value <=> root.theme-hue;
                                moved(v) => {
                                    root.theme-hue-changed(v);
                                }
                            }
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 11px;
                                background: Theme.accent;
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Tinte del fondo";
                                color: Theme.text-dim;
                                font-size: 12px;
                                width: 120px;
                                vertical-alignment: center;
                            }
                            NeuSlider {
                                horizontal-stretch: 1;
                                value <=> root.theme-tint;
                                moved(v) => {
                                    root.theme-tint-changed(v);
                                }
                            }
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 11px;
                                background: Theme.row-current;
                                border-width: 1px;
                                border-color: Theme.text-dim;
                            }
                        }
                    }
                }

                // Atajos globales.
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: "Atajos globales de teclado";
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 600;
                        }
                        Text {
                            text: root.hotkeys-help;
                            color: Theme.text-dim;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Text {
                            visible: root.hotkeys-status != "";
                            text: root.hotkeys-status;
                            color: Theme.accent;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        NeuSwitch {
                            on: root.hotkeys-enabled;
                            toggled => {
                                root.hotkeys-enabled = !root.hotkeys-enabled;
                                root.hotkeys-changed(root.hotkeys-enabled);
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    vertical-stretch: 1;
                    NeuPill {
                        label: "Cerrar";
                        min-width: 110px;
                        clicked => {
                            root.appearance-open = false;
                        }
                    }
                }
            }
        }
    }

    // ---------- Historial de reproducción ----------
    if root.history-open: Rectangle {
        width: root.width;
        height: root.height;
        background: #00000066;
        TouchArea {
            clicked => {
                root.history-open = false;
            }
        }

        NeuRaised {
            width: min(520px, parent.width - 48px);
            height: min(560px, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            radius: 24px;
            depth: 8px;
            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: "Historial de reproducción";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 700;
                    }
                    TextButton {
                        width: 90px;
                        label: "Borrar todo";
                        clicked => {
                            root.history-clear();
                        }
                    }
                }
                NeuInset {
                    vertical-stretch: 1;
                    radius: 18px;
                    if root.history-items.length == 0: Text {
                        text: "Aún no has reproducido nada";
                        color: Theme.text-dim;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if root.history-items.length > 0: ListView {
                        x: 8px;
                        y: 8px;
                        width: parent.width - 16px;
                        height: parent.height - 16px;
                        for entry[i] in root.history-items: HistoryRow {
                            item: entry;
                            activated => {
                                root.history-play(i);
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    NeuPill {
                        label: "Cerrar";
                        min-width: 110px;
                        clicked => {
                            root.history-open = false;
                        }
                    }
                }
            }
        }
    }
}