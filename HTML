<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Descargar Video</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
        }
        .container {
            width: 80%;
            margin: auto;
            padding: 20px;
        }
        .input-container {
            background-color: orange;
            padding: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .input-container input {
            width: 70%;
            padding: 10px;
            border: none;
        }
        .input-container button {
            padding: 10px 20px;
            border: none;
            background-color: #d35400;
            color: white;
            cursor: pointer;
        }
        .content {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-top: 20px;
        }
        .video-preview {
            width: 50%;
            text-align: center;
        }
        .video-box {
            width: 100%;
            height: 300px;
            background-color: black;
        }
        .download-options {
            width: 50%;
        }
        .download-table {
            width: 100%;
            border-collapse: collapse;
        }
        .download-table th, .download-table td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: left;
        }
        .download-table th {
            background-color: #f4f4f4;
        }
        .download-button {
            background-color: green;
            color: white;
            padding: 5px 10px;
            text-decoration: none;
            border-radius: 5px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="input-container">
            <input type="text" placeholder="INGRESE EL ENLACE">
            <button>EMPEZAR</button>
        </div>
        <div class="content">
            <div class="video-preview">
               <div class="video-box"></div>
                <p>VIDEO A DESCARGAR</p>
            </div>
            <div class="download-options">
                <table class="download-table">
                    <tr>
                        <th>Formato</th>
                        <th>Tamaño</th>
                        <th>Descargar</th>
                    </tr>
                    <tr>
                        <td>144p (.mp4)</td>
                        <td>5 MB</td>
                        <td><a href="#" class="download-button">Descargar</a></td>
                    </tr>
                    <tr>
                        <td>240p (.mp4)</td>
                        <td>10 MB</td>
                        <td><a href="#" class="download-button">Descargar</a></td>
                    </tr>
                    <tr>
                        <td>360p (.mp4)</td>
                        <td>18.5 MB</td>
                        <td><a href="#" class="download-button">Descargar</a></td>
                    </tr>
                    <tr>
                        <td>480p (.mp4)</td>
                        <td>30 MB</td>
                        <td><a href="#" class="download-button">Descargar</a></td>
                    </tr>
                    <tr>
                        <td>720p (.mp4)</td>
                        <td>58.6 MB</td>
                        <td><a href="#" class="download-button">Descargar</a></td>
                    </tr>
                    <tr>
                        <td>1080p (.mp4)</td>
                        <td>108.8 MB</td>
                        <td><a href="#" class="download-button">Descargar</a></td>
                    </tr>
                    <tr>
                        <td>1440p (.mp4)</td>
                        <td>200 MB</td>
                        <td><a href="#" class="download-button">Descargar</a></td>
                    </tr>
                    <tr>
                        <td>2160p (4K .mp4)</td>
                        <td>400 MB</td>
                        <td><a href="#" class="download-button">Descargar</a></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
